From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Zincwolf <zincwolf@outlook.com>
Date: Tue, 8 Sep 2026 14:50:52 +0800
Subject: [PATCH] Use QTIP-compatible 512-block Hadamard for unsupported widths

---
 .gitignore                            |  2 +-
 quip_sharp/linear/quantized_linear.py |  3 ++-
 quip_sharp/utils/matmul_had.py        | 24 ++++++++++++++++++++++--
 3 files changed, 25 insertions(+), 4 deletions(-)

diff --git a/.gitignore b/.gitignore
index 5678eac..ceb8894 100644
--- a/.gitignore
+++ b/.gitignore
@@ -5,7 +5,7 @@
 *.out
 *.json
 __pycache__/
-*.egg-info/
+**/*.egg-info/
 /build/
 /dist/
 #*
diff --git a/quip_sharp/linear/quantized_linear.py b/quip_sharp/linear/quantized_linear.py
index bdc26d0..ef2f6db 100644
--- a/quip_sharp/linear/quantized_linear.py
+++ b/quip_sharp/linear/quantized_linear.py
@@ -129,7 +129,8 @@ class QuantizedLinear(nn.Module):
                     len(self.SU),
                     len(self.SV),
                     self.Qidxs_list,
-                    self.had_left_T.T.contiguous(),
+                    # Power-of-two and 512-block transforms have no factor matrix.
+                    self.had_left_T.T.contiguous() if self.had_left_T is not None else None,
                     self.had_right,
                     self.K_left,
                     self.K_right,
diff --git a/quip_sharp/utils/matmul_had.py b/quip_sharp/utils/matmul_had.py
index f32e7e0..4ac7af9 100644
--- a/quip_sharp/utils/matmul_had.py
+++ b/quip_sharp/utils/matmul_had.py
@@ -4,6 +4,11 @@ import torch
 from quip_sharp import utils
 
 
+# Match the local QTIP adaptation for unsupported widths such as Qwen3's 9728.
+# Independent 512-wide blocks are NOT the upstream full-dimensional RHT.
+BLOCK_HADAMARD_SIZE = 512
+
+
 def get_hadK(n, transpose=False):
     hadK, K = None, None
     if n % 172 == 0:  # llama-2-7b up
@@ -55,8 +60,12 @@ def get_hadK(n, transpose=False):
         K = 12
         hadK = get_had12().T if transpose else get_had12()
     else:
-        assert (is_pow2(n))
-        K = 1
+        if is_pow2(n):
+            K = 1
+        elif n % BLOCK_HADAMARD_SIZE == 0:
+            K = -BLOCK_HADAMARD_SIZE
+        else:
+            raise ValueError(f"Unsupported Hadamard dimension: {n}")
 
     return hadK, K
 
@@ -64,6 +73,11 @@ def get_hadK(n, transpose=False):
 def matmul_hadU(X, transpose=False):
     n = X.shape[-1]
     hadK, K = get_hadK(n, transpose)
+    if K < 0:
+        # Reuse the reference transform per block, including FP64 on CUDA;
+        # fast_hadamard_transform only accepts FP32/FP16/BF16.
+        blocks = X.reshape(-1, -K)
+        return matmul_hadU(blocks, transpose=transpose).reshape(X.shape)
     input = X.clone().view(-1, n, 1)
     output = input.clone()
     while input.shape[1] > K:
@@ -100,6 +114,12 @@ def hadamard(x: torch.Tensor, scale: float) -> torch.Tensor:
 
 def matmul_hadU_cuda(X, hadK, K, transpose=False):
     n = X.shape[-1]
+    if K < 0:
+        block_size = -K
+        blocks = X.contiguous().reshape(*X.shape[:-1], n // block_size, block_size)
+        return torch.ops.quip_lib.hadamard(
+            blocks, block_size ** -0.5
+        ).reshape(X.shape)
     if K == 1:
         return torch.ops.quip_lib.hadamard(X.contiguous(), 1/(n**0.5))
 
