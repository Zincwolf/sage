 quip_sharp/utils/matmul_had.py            |  4 +--
 5 files changed, 27 insertions(+), 34 deletions(-)

diff --git a/quip_sharp/algo/quip.py b/quip_sharp/algo/quip.py
index aa7c9e5..0cbeed2 100644
--- a/quip_sharp/algo/quip.py
+++ b/quip_sharp/algo/quip.py
@@ -195,12 +195,8 @@ def LDLQ_buffered(Wr, Hr, L, D, cb, args, buf_cols=128):
                           dtype=cb.idx_dtype,
                           device=Hr.device)
 
-    device = Wr.device
