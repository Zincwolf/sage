-    Hr = Hr.cpu()
-    utils.clean()
-    Wr_T = Wr.T.contiguous().to(device)
-    Hr_T = Hr.T.contiguous().to(device)
+    Wr_T = Wr.T.contiguous()
+    Hr_T = Hr.T.contiguous()
 
