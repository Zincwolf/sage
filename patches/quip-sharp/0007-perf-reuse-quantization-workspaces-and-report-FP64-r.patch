@@ -229,7 +225,6 @@ def LDLQ_buffered(Wr, Hr, L, D, cb, args, buf_cols=128):
                 cur_col] = b_hatWr_T
 
     del b_Wr_T, b_hatWr_T, b_L, b_prod, L_offset, prod_cache
-    utils.clean()
 
     # tune
     for ie in range(args.quip_tune_iters):
@@ -273,7 +268,6 @@ def LDLQ_buffered(Wr, Hr, L, D, cb, args, buf_cols=128):
             Qidxs_T[cur_col - buf_size:cur_col] = b_Qidxs_T
 
         del delta_T, b_hatWr_T, b_Hr_T, b_delta_T, b_Qidxs_T, Hr_offset
-        utils.clean()
 
     return hatWr_T.T.contiguous(), Qidxs_T.T.contiguous()
 
@@ -314,7 +308,6 @@ def LDLQ_buffered_lowmem(Wr, Hr, L, D, cb, args, buf_cols=128):
         prod_cache += (b_Wr - b_hatWr) @ b_L
 
     del b_Wr, b_hatWr, b_L, b_prod, L_offset, prod_cache
-    utils.clean()
 
     # tune
     for ie in range(args.quip_tune_iters):
@@ -359,12 +352,12 @@ def LDLQ_buffered_lowmem(Wr, Hr, L, D, cb, args, buf_cols=128):
                         (i + 1)] -= b_hatWr[:,
                                             cb.codesz * i:cb.codesz * (i + 1)]
         del delta, b_hatWr, b_Hr, b_delta, b_Qidxs, Hr_offset
-        utils.clean()
 
     return hatWr, Qidxs
 
 
-def quantize(H_orig, W_orig, rank, codebook_orig, args, device='cpu'):
+def quantize(H_orig, W_orig, rank, codebook_orig, args, device='cpu', *,
+             reuse_codebook=False, on_retry=None):
     orig_device = H_orig.device
     W_orig_dtype = W_orig.dtype
     dtype_ = torch.float64 if args.use_fp64 else torch.float32
@@ -372,12 +365,15 @@ def quantize(H_orig, W_orig, rank, codebook_orig, args, device='cpu'):
 
     H = H_orig.clone().to(dtype_).to(device)
     W = W_orig.clone().to(dtype_).to(device)
-    codebook = copy.deepcopy(codebook_orig).to(dtype_)
+    # A caller may keep its fixed FP32 codebook on the device across projections.
+    # FP64 recovery still owns a copy, leaving that workspace unchanged.
+    codebook = (codebook_orig if reuse_codebook and not args.use_fp64
+                else copy.deepcopy(codebook_orig).to(dtype_))
 
     assert (m % 2 == 0)
     assert (n % 4 == 0)
-    assert (torch.all(torch.isfinite(H.cpu())))
-    assert (torch.all(torch.isfinite(W.cpu())))
+    assert (torch.all(torch.isfinite(H)))
+    assert (torch.all(torch.isfinite(W)))
 
     # incoherence preprocessing
     incoh_out = incoherence_preprocess(H, W, args)
@@ -389,11 +385,13 @@ def quantize(H_orig, W_orig, rank, codebook_orig, args, device='cpu'):
         glog.info('incoherence_preprocess failed, recomputing in fp64')
         del H, W, codebook
         utils.clean()
-        return quantize(H_orig, W_orig, rank, codebook_orig, new_args, device)
+        if on_retry is not None:
+            on_retry(new_args)
+        return quantize(H_orig, W_orig, rank, codebook_orig, new_args, device,
+                        reuse_codebook=reuse_codebook, on_retry=on_retry)
 
     Lhr, Hr, Wr, SU, SV, scaleWH = incoh_out
     del incoh_out
-    utils.clean()
 
     glog.info(f'mean square of W: {W.square().mean()}')
     glog.info(f'mean square of Wr: {Wr.square().mean()}')
@@ -417,12 +415,14 @@ def quantize(H_orig, W_orig, rank, codebook_orig, args, device='cpu'):
         glog.info('block_LDL failed, recomputing in fp64')
         del H, W, codebook, Lhr, Hr, Wr, SU, SV, scaleWH, Wo
         utils.clean()
-        return quantize(H_orig, W_orig, rank, codebook_orig, new_args, device)
+        if on_retry is not None:
+            on_retry(new_args)
+        return quantize(H_orig, W_orig, rank, codebook_orig, new_args, device,
+                        reuse_codebook=reuse_codebook, on_retry=on_retry)
 
     L, D = block_LDL_out
     del block_LDL_out
     del H_orig, W_orig, codebook_orig
-    utils.clean()
 
     # LDLQ
     Wscale = Wr.square().mean().sqrt()
@@ -451,12 +451,7 @@ def quantize(H_orig, W_orig, rank, codebook_orig, args, device='cpu'):
                                      args,
                                      buf_cols=128)
 
-    Wr = Wr.cpu()
-    Hr = Hr.cpu()
-    L = L.cpu()
-    D = D.cpu()
     del Wr, Hr, L, D
-    utils.clean()
 
     hatWr = hatWr * Wscale
 
@@ -483,8 +478,7 @@ def quantize(H_orig, W_orig, rank, codebook_orig, args, device='cpu'):
         'scaleWH': scaleWH,
     }
 
-    utils.clean()
-
+    # The caller releases the layer workspace at its boundary.
     return hatW.to(W_orig_dtype).to(orig_device), attr
 
 
