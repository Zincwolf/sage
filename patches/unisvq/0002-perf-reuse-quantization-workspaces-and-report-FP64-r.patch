-        return quantize(H_orig, W_orig, rank, codebook_orig, new_args, device)
+        if on_retry is not None:
+            on_retry(new_args)
+        return quantize(H_orig, W_orig, rank, codebook_orig, new_args, device,
+                        reuse_codebook=reuse_codebook, on_retry=on_retry)
 
     L, D = block_LDL_out
     del block_LDL_out
     del codebook_orig
-    utils.clean()
 
     # LDLQ
     Wscale = Wr.square().mean().sqrt() / getattr(codebook, "codebook_scale", 1.0)
@@ -442,12 +441,7 @@ def quantize(H_orig, W_orig, rank, codebook_orig, args, device='cpu'):
 
     del W_orig, H_orig
 
-    Wr = Wr.cpu()
-    Hr = Hr.cpu()
-    L = L.cpu()
-    D = D.cpu()
     del Wr, Hr, L, D
-    utils.clean()
 
     # best_hatWr = best_hatWr * best_Wscale
 
@@ -473,8 +467,7 @@ def quantize(H_orig, W_orig, rank, codebook_orig, args, device='cpu'):
         'scaleWH': scaleWH,
     }
 
-    utils.clean()
-
+    # The caller releases the layer workspace at its boundary.
     return hatW.to(W_orig_dtype).to(orig_device), attr
 
 
