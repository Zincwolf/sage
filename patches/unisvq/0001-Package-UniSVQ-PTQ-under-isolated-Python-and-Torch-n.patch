diff --git a/pyproject.toml b/pyproject.toml
new file mode 100644
index 0000000..61573e7
--- /dev/null
+++ b/pyproject.toml
@@ -0,0 +1,17 @@
+[build-system]
+requires = ["setuptools>=69.5.1"]
+build-backend = "setuptools.build_meta"
+
+[project]
+name = "unisvq"
+version = "0.0.0"
+description = "UniSVQ upstream PTQ components under an isolated package name"
+requires-python = ">=3.11"
+# Runtime dependencies are selected by the parent project's cu124/cu128 extras,
+# as for the other method packages. Do not select a second CUDA/Torch stack here.
+
+[tool.setuptools.packages.find]
+include = ["unisvq*"]
+
+[tool.setuptools.package-data]
+unisvq = ["codebook/*.pt", "utils/*.safetensors"]
