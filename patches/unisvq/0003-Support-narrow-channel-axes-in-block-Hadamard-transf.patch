From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Zincwolf <zincwolf@outlook.com>
Date: Sun, 13 Sep 2026 12:21:52 +0800
Subject: [PATCH] Support narrow channel axes in block Hadamard transforms

---
 unisvq/utils/matmul_had.py | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/unisvq/utils/matmul_had.py b/unisvq/utils/matmul_had.py
index eb55bba..f461911 100644
--- a/unisvq/utils/matmul_had.py
+++ b/unisvq/utils/matmul_had.py
@@ -16,13 +16,13 @@ del k_sort
 
 
 def get_hadK(n, transpose=False):
-    n = 128
     hadK = torch.tensor([[1]])
     K = 1
     return hadK, K
 
 def matmul_hadU(X, transpose=False):
-    n = 128 
+    # Keep the released 128-block RHT; narrow axes use their full width (e.g. 32).
+    n = min(X.shape[-1], 128)
     hadK, K = get_hadK(n, transpose)
     input = X.clone().reshape(-1, n, 1) # m, n, 1
     output = input.clone()
@@ -57,7 +57,7 @@ def hadamard(x: torch.Tensor, scale: float) -> torch.Tensor:
 
 
 def matmul_hadU_cuda(X, hadK, K, transpose=False):
-    n = 128
+    n = min(X.shape[-1], 128)
     input = X.float().view(-1, K, n // K)
     if K == 1:
         return torch.ops.unisvq_lib.hadamard(input.contiguous(), 1/(n**0.5)).reshape(X.shape).to(X.dtype)
@@ -88,6 +88,6 @@ class HadamardFunction(torch.autograd.Function):
         return torch.ops.unisvq_lib.hadamard(grad_output, scale), None
 
 def matmul_hadU_cuda_blockwise(X):
-    BLOCK_SIZE = 128
+    BLOCK_SIZE = min(X.shape[-1], 128)
     input_x = X.view(-1, 1, BLOCK_SIZE)
     return HadamardFunction.apply(input_x, BLOCK_SIZE**(-0.5)).view(X.shape)
\ No newline at end of file
