@@ -109,3 +132,10 @@ def test_text_pseudo_export_roundtrip(source_model, tmp_path, monkeypatch, metho
         output = restored(torch.randint(0, 64, (1, 8)), use_cache=False)
     assert torch.isfinite(output.logits).all()
     assert "quantization_config" not in restored.config.to_dict()
+    if model.config.model_type == "qwen3_5":
+        with safe_open(source / "model.safetensors", framework="pt") as original:
