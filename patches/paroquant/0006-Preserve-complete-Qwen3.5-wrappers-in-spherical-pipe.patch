+        )
+        model = Qwen3_5ForConditionalGeneration(
+            Qwen3_5Config(text_config=text, vision_config=vision)
+        ).eval()
     source = tmp_path / "source"
-    model.save_pretrained(source)
+    state = model.state_dict()
+    if request.param == "qwen3_5":
+        state["mtp.fc.weight"] = torch.randn(128, 256)
+    model.save_pretrained(source, state_dict=state)
     return source, model
 
 
@@ -81,7 +104,7 @@ def test_text_pseudo_export_roundtrip(source_model, tmp_path, monkeypatch, metho
                 projection, sample_size=256, kmeans_iterations=1, codebook_bits=6 + index, seed=0
             )
         torch.save(quantized.state_dict(), result_dir / f"0.self_attn.{name}.pt")
