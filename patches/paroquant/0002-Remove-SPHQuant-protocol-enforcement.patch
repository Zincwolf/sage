From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Zincwolf <zincwolf@outlook.com>
Date: Fri, 21 Aug 2026 17:36:36 +0800
Subject: [PATCH] Remove SPHQuant protocol enforcement

---
 paroquant/cli/optimize.py | 21 ---------------------
 1 file changed, 21 deletions(-)

diff --git a/paroquant/cli/optimize.py b/paroquant/cli/optimize.py
index 6c27782..97c026c 100644
--- a/paroquant/cli/optimize.py
+++ b/paroquant/cli/optimize.py
@@ -114,27 +114,6 @@ def setup_wandb(args: Config) -> wandb.Run | None:
 def main():
     args = simple_parsing.parse(Config, add_option_string_dash_variants=simple_parsing.DashVariant.DASH)
     print(args)
-    if args.method == "sphquant":
-        if args.group_size != 128 or args.n_bit != 2:
-            raise ValueError(
-                "SPHQuant W2 reproduction requires group_size=128 and n_bit=2"
-            )
-        if args.params != ["radius:0.001,codebook:0.001"]:
-            raise ValueError(
-                "SPHQuant reproduction requires one joint parameter stage: "
-                "radius:0.001,codebook:0.001"
-            )
-        if args.epochs not in ([0], [20]) or args.loss != "mse":
-            raise ValueError(
-                "SPHQuant reproduction requires MSE and either zero "
-                "(No-Tuning) or 20 joint epochs"
-            )
-        if args.optimizer != "adam" or args.use_lr_scheduler:
-            raise ValueError(
-                "SPHQuant reproduction requires Adam without ParoQuant's "
-                "cosine scheduler"
-            )
-
     # Store the results in a subdirectory.
     model_name = args.model.split("/")[-1]
     output_dir = Path(args.output_dir)
