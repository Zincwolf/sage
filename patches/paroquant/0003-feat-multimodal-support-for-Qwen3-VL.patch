+def apply_deepstack_context(
+    hidden_states: torch.Tensor,
+    context: dict,
+    layer_idx: int,
+) -> torch.Tensor:
+    """Replay Qwen3-VL's post-decoder DeepStack visual feature injection."""
+    visual_embeds = context.get("deepstack_visual_embeds")
+    if visual_embeds is None or layer_idx >= len(visual_embeds):
+        return hidden_states
+    visual_pos_masks = context.get("visual_pos_masks")
+    if visual_pos_masks is None:
+        raise ValueError("DeepStack visual embeddings require visual_pos_masks")
+    visual_pos_masks = visual_pos_masks.to(
+        device=hidden_states.device,
+        dtype=torch.bool,
+    )
+    visual_embed = visual_embeds[layer_idx].to(
+        device=hidden_states.device,
+        dtype=hidden_states.dtype,
+    )
+    if int(visual_pos_masks.sum()) != visual_embed.shape[0]:
+        raise ValueError(
+            "DeepStack mask/embed mismatch: "
+            f"{int(visual_pos_masks.sum())} positions vs "
+            f"{visual_embed.shape[0]} embeddings"
+        )
+    output = hidden_states.clone()
+    output[visual_pos_masks, :] += visual_embed
+    return output
+
