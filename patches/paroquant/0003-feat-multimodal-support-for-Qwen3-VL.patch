--- /dev/null
+++ b/tests/test_multimodal_capture.py
@@ -0,0 +1,207 @@
+import torch
+
+from paroquant.optim.multimodal import apply_deepstack_context
+from paroquant.optim.util import capture_layer_inputs_and_args
+
+
+class ToyLayer(torch.nn.Module):
+    def forward(
+        self,
+        hidden_states,
+        position_embeddings,
+        attention_mask=None,
+        position_ids=None,
+    ) -> torch.Tensor:
+        assert attention_mask is not None
+        assert position_ids is not None
+        assert position_embeddings is not None
+        return hidden_states + 1
+
+
+class ToyTextModel(torch.nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.layers = torch.nn.ModuleList(
+            [ToyLayer(), ToyLayer(), ToyLayer()]
+        )
+
+    def _deepstack_process(
+        self,
+        hidden_states,
+        visual_pos_masks,
+        visual_embeds,
+    ):
+        hidden_states = hidden_states.clone()
+        hidden_states[visual_pos_masks, :] += visual_embeds.to(
+            hidden_states.dtype
+        )
+        return hidden_states
+
+    def forward(
+        self,
+        inputs_embeds,
+        attention_mask,
+        visual_pos_masks=None,
+        deepstack_visual_embeds=None,
+    ):
+        hidden = inputs_embeds
+        batch_size, sequence_length = hidden.shape[:2]
+        position_ids = torch.arange(sequence_length)[None].expand(
+            batch_size,
+            -1,
+        )
+        position_embeddings = (
+            torch.full_like(hidden, 2.0),
+            torch.full_like(hidden, 3.0),
+        )
+        for layer_idx, layer in enumerate(self.layers):
+            hidden = layer(
+                hidden,
+                position_embeddings=position_embeddings,
+                attention_mask=attention_mask,
+                position_ids=position_ids,
+            )
+            if (
+                deepstack_visual_embeds is not None
+                and layer_idx < len(deepstack_visual_embeds)
+            ):
+                hidden = self._deepstack_process(
+                    hidden,
+                    visual_pos_masks,
+                    deepstack_visual_embeds[layer_idx],
+                )
+        return hidden
+
+
+class ToyInnerModel(torch.nn.Module):
+    def __init__(self, *, deepstack_layers=0):
+        super().__init__()
+        self.language_model = ToyTextModel()
+        self.deepstack_layers = deepstack_layers
+
+    def forward(self, input_ids, attention_mask, use_cache=False):
+        del use_cache
+        visual_pos_masks = input_ids == 9
+        visual_tokens = int(visual_pos_masks.sum())
+        deepstack_visual_embeds = [
+            torch.full((visual_tokens, 1), float(10 * (index + 1)))
+            for index in range(self.deepstack_layers)
+        ]
+        return self.language_model(
+            inputs_embeds=input_ids[..., None].float(),
+            attention_mask=attention_mask,
+            visual_pos_masks=(
+                visual_pos_masks if deepstack_visual_embeds else None
+            ),
+            deepstack_visual_embeds=(
+                deepstack_visual_embeds or None
+            ),
+        )
+
+
+class ToyImageTextModel(torch.nn.Module):
+    def __init__(self, *, deepstack_layers=0):
+        super().__init__()
+        self.model = ToyInnerModel(deepstack_layers=deepstack_layers)
+
+    def forward(self, *args, **kwargs):
+        return self.model(*args, **kwargs)
+
+
+def test_capture_preserves_per_batch_layer_kwargs_and_mrope():
+    model = ToyImageTextModel()
+    batches = [
+        {
+            "input_ids": torch.tensor([[1, 2, 3]]),
+            "attention_mask": torch.ones(1, 3),
+        },
+        {
+            "input_ids": torch.tensor([[4, 5, 6, 7]]),
+            "attention_mask": torch.ones(1, 4),
+        },
+    ]
+    inputs, kwargs, other_args, retained, deepstack = (
+        capture_layer_inputs_and_args(
+            model,
+            model.model.language_model.layers,
+            batches,
+            batch_size=None,
+            device="cpu",
+        )
+    )
+
+    assert [tuple(item.shape) for item in inputs] == [
+        (1, 3, 1),
+        (1, 4, 1),
+    ]
+    assert [tuple(item["attention_mask"].shape) for item in kwargs[0]] == [
+        (1, 3),
+        (1, 4),
+    ]
+    assert [tuple(item["position_ids"].shape) for item in kwargs[0]] == [
+        (1, 3),
+        (1, 4),
+    ]
+    cos, sin = kwargs[0][0]["position_embeddings"]
+    assert tuple(cos.shape) == (1, 3, 1)
+    assert tuple(sin.shape) == (1, 3, 1)
+    next_cos, next_sin = kwargs[1][0]["position_embeddings"]
+    assert cos is next_cos
+    assert sin is next_sin
+    assert all(not args for layer_args in other_args for args in layer_args)
+    assert retained == [{}, {}]
+    assert [
+        tuple(context["valid_token_mask"].shape)
+        for context in deepstack
+    ] == [(1, 3), (1, 4)]
+
+
+def test_capture_and_replay_qwen3vl_deepstack_context():
+    model = ToyImageTextModel(deepstack_layers=3)
+    batches = [
+        {
+            "input_ids": torch.tensor([[1, 9, 2]]),
+            "attention_mask": torch.ones(1, 3),
+        }
+    ]
+    inputs, _, _, _, deepstack = capture_layer_inputs_and_args(
+        model,
+        model.model.language_model.layers,
+        batches,
+        batch_size=None,
+        device="cpu",
+    )
+
+    assert len(inputs) == 1
+    assert len(deepstack) == 1
+    context = deepstack[0]
+    assert context["valid_token_mask"].tolist() == [[1.0, 1.0, 1.0]]
+    assert context["visual_pos_masks"].tolist() == [[False, True, False]]
+    assert len(context["deepstack_visual_embeds"]) == 3
+
+    raw = torch.zeros(1, 3, 1)
+    for layer_idx in range(3):
+        expected = model.model.language_model._deepstack_process(
+            raw,
+            context["visual_pos_masks"],
+            context["deepstack_visual_embeds"][layer_idx],
+        )
+        actual = apply_deepstack_context(raw, context, layer_idx)
+        torch.testing.assert_close(actual, expected)
+    torch.testing.assert_close(
+        apply_deepstack_context(raw, context, layer_idx=3),
+        raw,
+    )
+
+
+def test_apply_deepstack_context_rejects_mask_embed_mismatch():
+    context = {
+        "visual_pos_masks": torch.tensor([[False, True, False]]),
+        "deepstack_visual_embeds": [torch.ones(2, 1)],
+    }
+    try:
+        apply_deepstack_context(torch.zeros(1, 3, 1), context, layer_idx=0)
+    except ValueError as error:
+        assert "mask/embed mismatch" in str(error)
+    else:
+        raise AssertionError("Expected DeepStack mask/embed mismatch")
