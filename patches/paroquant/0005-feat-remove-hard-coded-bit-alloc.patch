     # Number of shards to cache the input/output tensors. At any time, only one shard
@@ -474,7 +475,10 @@ def main():
                 sd = torch.load(existing_result_file, map_location=device)
                 if isinstance(old_module, nn.Linear):
                     if args.method == "sphquant":
-                        new_module = SPHPseudoQuantizedLinear.from_state_dict(sd)
+                        new_module = SPHPseudoQuantizedLinear.from_state_dict(
+                            sd,
+                            codebook_bits=args.sph_codebook_bits,
