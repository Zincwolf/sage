                     else:
                         from paroquant.optim.qlinear import PseudoQuantizedLinear
 
@@ -502,6 +506,7 @@ def main():
                         old_module,
                         sample_size=args.sph_sample_size,
                         kmeans_iterations=args.sph_kmeans_iterations,
+                        codebook_bits=args.sph_codebook_bits,
                         seed=args.seed + layer_idx,
                     )
                 else:
diff --git a/paroquant/optim/sphlinear.py b/paroquant/optim/sphlinear.py
index 60399a2..9771f43 100644
--- a/paroquant/optim/sphlinear.py
+++ b/paroquant/optim/sphlinear.py
@@ -9,8 +9,9 @@ from torch.utils.checkpoint import checkpoint
 
 VECTOR_SIZE = 8
 GROUP_SIZE = 128
-RADIUS_BITS = 4
-NUM_DIRECTIONS = 64
+INDEX_AND_RADIUS_BITS = 10
+DEFAULT_CODEBOOK_BITS = 6
+DEFAULT_RADIUS_BITS = INDEX_AND_RADIUS_BITS - DEFAULT_CODEBOOK_BITS
 ANGLE_EPS = 1e-4
 
 
@@ -61,7 +62,7 @@ def direction_logits_from_codebook(codebook: torch.Tensor) -> torch.Tensor:
 def radius_fake_quantize(
     radius: torch.Tensor,
     *,
-    bits: int = RADIUS_BITS,
+    bits: int = DEFAULT_RADIUS_BITS,
     group_size: int = GROUP_SIZE,
 ) -> torch.Tensor:
     vectors_per_group = group_size // VECTOR_SIZE
@@ -111,19 +112,23 @@ def spherical_kmeans(
     *,
     sample_size: int = 65536,
     iterations: int = 20,
+    num_directions: int = 1 << DEFAULT_CODEBOOK_BITS,
     seed: int = 0,
 ) -> torch.Tensor:
     if directions.ndim != 2 or directions.shape[1] != VECTOR_SIZE:
         raise ValueError(f"Expected [N, 8] directions, got {directions.shape}")
-    if directions.shape[0] < NUM_DIRECTIONS:
-        raise ValueError("Not enough vectors for a 64-entry direction codebook")
+    sample_count = min(sample_size, directions.shape[0])
+    if sample_count < num_directions:
+        raise ValueError(
+            f"Need at least {num_directions} sampled vectors for the direction "
+            f"codebook, got {sample_count}"
+        )
     weights = radius.float().square()
     if float(weights.sum()) == 0:
         probabilities = torch.full_like(weights, 1 / weights.numel())
     else:
         probabilities = weights / weights.sum()
     generator = torch.Generator(device=directions.device).manual_seed(seed)
-    sample_count = min(sample_size, directions.shape[0])
     sampled_ids = torch.multinomial(
         probabilities,
         sample_count,
@@ -135,14 +140,14 @@ def spherical_kmeans(
         sample_count,
         device=directions.device,
         generator=generator,
-    )[:NUM_DIRECTIONS]
+    )[:num_directions]
     centers = sampled[initial].clone()
     centers /= centers.norm(dim=1, keepdim=True).clamp_min(1e-12)
     for _ in range(iterations):
         assignments = assign_directions(sampled, centers)
         sums = torch.zeros_like(centers)
         counts = torch.zeros(
-            NUM_DIRECTIONS,
+            num_directions,
             dtype=torch.long,
             device=centers.device,
         )
@@ -160,6 +165,7 @@ def initialize_spherical_weight(
     *,
     sample_size: int = 65536,
     kmeans_iterations: int = 20,
+    codebook_bits: int = DEFAULT_CODEBOOK_BITS,
     seed: int = 0,
 ) -> dict[str, torch.Tensor]:
     if weight.ndim != 2 or weight.shape[1] % GROUP_SIZE:
@@ -178,6 +184,7 @@ def initialize_spherical_weight(
         radius,
         sample_size=sample_size,
         iterations=kmeans_iterations,
+        num_directions=1 << codebook_bits,
         seed=seed,
     )
     indices = assign_directions(directions, codebook)
@@ -218,16 +225,20 @@ class SPHPseudoQuantizedLinear(nn.Module):
         *,
         sample_size: int = 65536,
         kmeans_iterations: int = 20,
+        codebook_bits: int = DEFAULT_CODEBOOK_BITS,
         seed: int = 0,
         initialized: dict[str, torch.Tensor] | None = None,
     ) -> None:
         super().__init__()
+        if not 1 <= codebook_bits <= 8:
+            raise ValueError("codebook_bits must be within [1, 8]")
         self.enable_checkpoint = False
         if initialized is None:
             initialized = initialize_spherical_weight(
                 linear.weight,
                 sample_size=sample_size,
                 kmeans_iterations=kmeans_iterations,
+                codebook_bits=codebook_bits,
                 seed=seed,
             )
         self.register_buffer("signs", initialized["signs"].contiguous())
@@ -248,7 +259,7 @@ class SPHPseudoQuantizedLinear(nn.Module):
             self.bias.requires_grad_(False)
         self.register_buffer(
             "radius_bits",
-            torch.tensor(RADIUS_BITS, dtype=torch.int32),
+            torch.tensor(INDEX_AND_RADIUS_BITS - codebook_bits, dtype=torch.int32),
         )
         self.register_buffer(
             "group_size",
@@ -312,8 +323,21 @@ class SPHPseudoQuantizedLinear(nn.Module):
     def from_state_dict(
         cls,
         state_dict: dict[str, torch.Tensor],
+        *,
+        codebook_bits: int | None = None,
     ) -> "SPHPseudoQuantizedLinear":
         signs = state_dict["signs"]
+        num_directions = state_dict["angle_logits"].shape[0]
+        checkpoint_codebook_bits = num_directions.bit_length() - 1
+        if 1 << checkpoint_codebook_bits != num_directions:
+            raise ValueError(
+                f"Direction codebook size must be a power of two, got {num_directions}"
+            )
+        if codebook_bits is not None and codebook_bits != checkpoint_codebook_bits:
+            raise ValueError(
+                f"Configured {codebook_bits}-bit direction codebook does not match "
+                f"{checkpoint_codebook_bits}-bit checkpoint"
+            )
         linear = nn.Linear(
             signs.shape[1],
             signs.shape[0],
@@ -327,6 +351,10 @@ class SPHPseudoQuantizedLinear(nn.Module):
             "radius_logits": state_dict["radius_logits"],
             "angle_logits": state_dict["angle_logits"],
         }
-        module = cls(linear, initialized=initialized)
+        module = cls(
+            linear,
+            codebook_bits=checkpoint_codebook_bits,
+            initialized=initialized,
+        )
         module.load_state_dict(state_dict)
         return module
diff --git a/tests/test_sphlinear.py b/tests/test_sphlinear.py
index f219ea7..cc66474 100644
--- a/tests/test_sphlinear.py
+++ b/tests/test_sphlinear.py
@@ -1,3 +1,4 @@
+import pytest
 import torch
 from torch import nn
 
@@ -63,6 +64,30 @@ def test_sph_linear_forward_backward_and_state_roundtrip():
     torch.testing.assert_close(module.direction_indices, indices_before)
 
 
+def test_eight_bit_codebook_uses_256_directions_and_two_bit_radii():
+    torch.manual_seed(0)
+    module = SPHPseudoQuantizedLinear(
+        nn.Linear(128, 16, bias=False),
+        sample_size=256,
+        kmeans_iterations=1,
+        codebook_bits=8,
+    )
+    assert module.angle_logits.shape == (256, 7)
+    assert module.direction_indices.dtype == torch.uint8
+    assert module.radius_bits.item() == 2
+
+    restored = SPHPseudoQuantizedLinear.from_state_dict(
+        module.state_dict(),
+        codebook_bits=8,
+    )
+    torch.testing.assert_close(restored.pseudo_weight(), module.pseudo_weight())
+    with pytest.raises(ValueError, match="does not match"):
+        SPHPseudoQuantizedLinear.from_state_dict(
+            module.state_dict(),
+            codebook_bits=6,
+        )
+
+
 def test_only_requested_parameter_groups_are_trainable():
     module = SPHPseudoQuantizedLinear(
         nn.Linear(128, 4, bias=True),
