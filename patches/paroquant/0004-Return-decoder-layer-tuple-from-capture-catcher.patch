From 5d9401d968eb6502d7dc55a374fba6988c1b90b7 Mon Sep 17 00:00:00 2001
From: Zincwolf <zincwolf@outlook.com>
Date: Fri, 21 Aug 2026 18:03:31 +0800
Subject: [PATCH 4/5] Return decoder layer tuple from capture catcher

---
 paroquant/optim/util.py | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/paroquant/optim/util.py b/paroquant/optim/util.py
index 8b65576..14eb71f 100644
--- a/paroquant/optim/util.py
+++ b/paroquant/optim/util.py
@@ -300,7 +300,9 @@ def capture_layer_inputs_and_args(
             if self.layer_idx == 0:
                 retained_kwargs_batches.append(retained_kwargs)
 
-            return torch.empty_like(args[0], device=device)
+            # Decoder layers in transformers==4.52.4 return a tuple; the
+            # model stack immediately reads layer_outputs[0].
+            return (torch.empty_like(args[0], device=device),)
 
         def __getattr__(self, name):
             return getattr(self.module, name)
