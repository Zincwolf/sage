+    # Stop at the backbone so calibration does not materialize unused logits.
+    class StopCaptureForward(Exception):
+        pass
+
+    def stop_after_backbone(_module, _args, _output):
+        raise StopCaptureForward
+
+    backbone = getattr(model, "model", model)
+    stop_hook = backbone.register_forward_hook(stop_after_backbone)
+    try:
