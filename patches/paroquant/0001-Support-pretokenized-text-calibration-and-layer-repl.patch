@@ -0,0 +1,108 @@
+import pytest
+import torch
+from transformers import Qwen3Config, Qwen3ForCausalLM
+
+from paroquant.optim.train import optimize_module
+from paroquant.optim.util import capture_layer_inputs_and_args
+
+
+@pytest.fixture
+def model():
+    return Qwen3ForCausalLM(
+        Qwen3Config(
+            vocab_size=64,
+            hidden_size=128,
+            intermediate_size=256,
+            num_hidden_layers=2,
+            num_attention_heads=4,
+            num_key_value_heads=2,
+            head_dim=32,
+        )
+    ).eval()
+
+
+@pytest.mark.parametrize("batch_size", [None, 1, 2])
+def test_text_capture_preserves_inputs_and_kwargs_without_logits(model, batch_size):
+    samples = torch.randint(0, 64, (4, 8))
+    layers = list(model.model.layers)
+
+    def reject_logits(*_args):
+        pytest.fail("calibration must stop before the LM head")
+
+    handle = model.lm_head.register_forward_pre_hook(reject_logits)
+    try:
+        inputs, kwargs, other_args, retained = capture_layer_inputs_and_args(
+            model, model.model.layers, samples, batch_size=batch_size
+        )
+    finally:
+        handle.remove()
+
+    torch.testing.assert_close(torch.cat(inputs), model.model.embed_tokens(samples))
+    num_batches = 4 // (batch_size or 4)
+    assert len(inputs) == num_batches
+    assert retained == [{} for _ in range(num_batches)]
+    assert all(len(layer_kwargs) == num_batches for layer_kwargs in kwargs)
+    assert all(not args for layer_args in other_args for args in layer_args)
+    for batch_idx in range(num_batches):
+        first = kwargs[0][batch_idx]
+        assert "use_cache" not in first
+        assert "past_key_values" not in first
+        assert first["position_ids"].shape[-1] == 8
+        cos, sin = first["position_embeddings"]
+        next_cos, next_sin = kwargs[1][batch_idx]["position_embeddings"]
+        assert cos is next_cos
+        assert sin is next_sin
+        assert cos.device.type == "cpu"
+    assert list(model.model.layers) == layers
+    assert not model.model._forward_hooks
+    assert model(samples, use_cache=False).logits.shape == (4, 8, 64)
+
+
+def test_text_capture_restores_layers_and_hook_after_failure(model):
+    layers = list(model.model.layers)
+
+    def fail_embedding(*_args):
+        raise RuntimeError("embedding failed")
+
+    handle = model.model.embed_tokens.register_forward_hook(fail_embedding)
+    try:
+        with pytest.raises(RuntimeError, match="embedding failed"):
+            capture_layer_inputs_and_args(
+                model, model.model.layers, torch.ones(2, 8, dtype=torch.long), batch_size=1
+            )
+    finally:
+        handle.remove()
+    assert list(model.model.layers) == layers
+    assert not model.model._forward_hooks
+
+
+@pytest.mark.skipif(not torch.cuda.is_available(), reason="layer replay training uses CUDA")
+def test_training_moves_nested_cached_kwargs_to_input_device():
+    class OffsetLinear(torch.nn.Linear):
+        def forward(self, inputs, *, context):
+            offset = context[0]["offset"]
+            assert offset.device == inputs.device
+            return super().forward(inputs) + offset
+
+    module = OffsetLinear(1, 1, bias=False).cuda()
+    torch.nn.init.zeros_(module.weight)
+    inputs = [(torch.ones(1, 1, device="cuda"),) for _ in range(2)]
+    outputs = [torch.full((1, 1), 0.2, device="cuda") for _ in range(2)]
+    kwargs = [
+        {"context": ({"offset": torch.tensor([[0.05 * index]])},)}
+        for index in range(2)
+    ]
+    steps = optimize_module(
+        module,
+        (inputs, outputs),
+        (inputs, outputs),
+        kwargs,
+        kwargs,
+        [{"params": module.parameters(), "lr": 0.01}],
+        loss_fn="mse",
+        n_iter=1,
+        early_stop=None,
+    )
+    assert steps == 2
+    assert module.weight.item() > 0
+    assert all(batch["context"][0]["offset"].device.type == "cpu" for batch in kwargs)
