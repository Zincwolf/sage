diff --git a/tests/test_spherical_moe.py b/tests/test_spherical_moe.py
new file mode 100644
index 0000000..688873d
--- /dev/null
+++ b/tests/test_spherical_moe.py
@@ -0,0 +1,103 @@
+"""Spherical QDQ uses expert Linear views without changing HF routing/storage."""
+
+from copy import deepcopy
+
+import pytest
+import torch
+from paroquant.cli.convert import _convert_pseudo
+from paroquant.optim.moe import projection_weight, split_work_experts
+from paroquant.optim.sagelinear import SAGEPseudoQuantizedLinear
+from paroquant.optim.sphlinear import SPHPseudoQuantizedLinear
+from paroquant.optim.util import get_spherical_linears
+from transformers import Qwen3MoeConfig, Qwen3MoeForCausalLM
+
+
+@pytest.fixture
+def native_moe():
+    torch.set_num_threads(2)
+    torch.manual_seed(17)
+    config = Qwen3MoeConfig(
+        vocab_size=32,
+        hidden_size=128,
+        intermediate_size=256,
+        moe_intermediate_size=128,
+        num_hidden_layers=1,
+        num_attention_heads=4,
+        num_key_value_heads=2,
+        num_experts=4,
+        num_experts_per_tok=2,
+    )
+    config.update({"head_dim": 32})
+    model = Qwen3MoeForCausalLM(config).eval()
+    model.set_experts_implementation("eager")
+    return model
+
+
+def test_expert_views_follow_top_two_routes_and_backpropagate(native_moe):
+    original = native_moe.model.layers[0]
+    work = deepcopy(original)
+    split_work_experts(work)
+    x = torch.randn(5, 128)
+    routes = torch.tensor([[0, 1], [1, 0], [0, 2], [2, 1], [1, 2]])
+    weights = torch.rand(5, 2).softmax(-1)
+    expected = original.mlp.experts(x, routes, weights)
+    actual = work.mlp.experts(x, routes, weights)
+    torch.testing.assert_close(actual, expected)
+    actual.square().sum().backward()
+    for index, expert in enumerate(work.mlp.experts):
+        for parameter in expert.parameters():
+            assert (parameter.grad is None) == (index == 3)
+    linears = get_spherical_linears(work)
+    assert len(linears) == 4 + 4 * 3
+    assert "mlp.gate" not in linears
+    for name, linear in linears.items():
+        torch.testing.assert_close(linear.weight, projection_weight(original, name), atol=0, rtol=0)
+    assert work.mlp.gate is not original.mlp.gate
+    assert all(parameter.grad is None for parameter in original.parameters())
+
+
+@pytest.mark.skipif(not torch.cuda.is_available(), reason="dense conversion uses CUDA")
+@pytest.mark.parametrize("method", ["sphquant", "sage"])
+@pytest.mark.parametrize("dtype", [torch.float16, torch.bfloat16])
+def test_mixed_expert_formats_copy_into_native_storage(native_moe, tmp_path, method, dtype):
+    native_moe.to(dtype)
+    original = {name: value.clone() for name, value in native_moe.state_dict().items()}
+    expected = deepcopy(native_moe)
+    work = deepcopy(native_moe.model.layers[0]).cuda()
+    split_work_experts(work)
+    targets = ["mlp.experts.0.gate_proj", "mlp.experts.1.up_proj", "mlp.experts.2.down_proj"]
+    pseudo_class = SAGEPseudoQuantizedLinear if method == "sage" else SPHPseudoQuantizedLinear
+    for index, name in enumerate(targets):
+        kwargs = {}
+        if method == "sage":
+            kwargs = {"channel_energy": torch.logspace(-2, 2, 128), "adaptive_bits": False}
+        pseudo = pseudo_class(
+            work.get_submodule(name),
+            codebook_bits=6 + index,
+            sample_size=256,
+            kmeans_iterations=1,
+            seed=17,
+            **kwargs,
+        )
+        torch.save(pseudo.state_dict(), tmp_path / f"0.{name}.pt")
+        projection_weight(expected.model.layers[0], name).data.copy_(pseudo.pseudo_weight().cpu())
+    fused = native_moe.model.layers[0].mlp.experts
+    assert _convert_pseudo(native_moe, tmp_path) == 3
+    assert native_moe.model.layers[0].mlp.experts is fused
+    assert native_moe.state_dict().keys() == original.keys()
+    for name, value in native_moe.state_dict().items():
+        torch.testing.assert_close(value, expected.state_dict()[name], atol=0, rtol=0)
+        assert value.device.type == "cpu"
+    # An unconverted expert and the router are preserved exactly.
+    torch.testing.assert_close(
+        fused.gate_up_proj[3],
+        original["model.layers.0.mlp.experts.gate_up_proj"][3],
+        atol=0,
+        rtol=0,
+    )
+    torch.testing.assert_close(
+        native_moe.model.layers[0].mlp.gate.weight,
+        original["model.layers.0.mlp.gate.weight"],
+        atol=0,
+        rtol=0,
+    )
