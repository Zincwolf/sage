From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Zincwolf <zincwolf@outlook.com>
Date: Fri, 21 Aug 2026 17:59:31 +0800
Subject: [PATCH] Use transformers 4.52 torch_dtype loading API

---
 paroquant/optim/util.py | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/paroquant/optim/util.py b/paroquant/optim/util.py
index b5ac9a0..8b65576 100644
--- a/paroquant/optim/util.py
+++ b/paroquant/optim/util.py
@@ -76,7 +76,9 @@ def set_module_by_name(layer, name, new_module):
 
 
 def load_model(model_path: str, device_map: str | None = None, dtype=torch.float32, **kwargs) -> nn.Module:
-    common = dict(device_map=device_map, dtype=dtype, **kwargs)
+    # transformers==4.52.4 forwards ``dtype`` to Qwen3ForCausalLM.__init__,
+    # which only accepts the older ``torch_dtype`` loading argument.
+    common = dict(device_map=device_map, torch_dtype=dtype, **kwargs)
     try:
         return AutoModelForImageTextToText.from_pretrained(model_path, **common)
     except (ValueError, KeyError):
