 paroquant/optim/util.py  | 10 +++++++---
 tests/test_sphconvert.py | 39 +++++++++++++++++++++++++++++++--------
 3 files changed, 42 insertions(+), 16 deletions(-)

diff --git a/paroquant/cli/convert.py b/paroquant/cli/convert.py
index 82ed0b0..8d9fa6f 100644
--- a/paroquant/cli/convert.py
