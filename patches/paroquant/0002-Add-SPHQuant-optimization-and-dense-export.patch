+++ b/tests/test_sphconvert.py
@@ -0,0 +1,70 @@
+import sys
+
+import pytest
+import torch
+from transformers import AutoModelForCausalLM, Qwen3Config, Qwen3ForCausalLM
+
+from paroquant.cli import convert
+from paroquant.optim.sphlinear import SPHPseudoQuantizedLinear
+from paroquant.optim.util import load_model
+
+
+@pytest.fixture
+def source_model(tmp_path):
+    model = Qwen3ForCausalLM(
+        Qwen3Config(
+            vocab_size=64,
+            hidden_size=128,
+            intermediate_size=256,
+            num_hidden_layers=1,
+            num_attention_heads=4,
+            num_key_value_heads=2,
+            head_dim=32,
+        )
+    ).eval()
+    source = tmp_path / "source"
+    model.save_pretrained(source)
+    return source, model
+
+
+def test_text_loaders_preserve_source_weights(source_model):
+    source, model = source_model
+    for restored in (convert._load_model(str(source)), load_model(str(source))):
+        assert isinstance(restored, Qwen3ForCausalLM)
+        for key, value in model.state_dict().items():
+            torch.testing.assert_close(restored.state_dict()[key], value)
+
+
+@pytest.mark.skipif(not torch.cuda.is_available(), reason="pseudo conversion uses CUDA")
+def test_text_pseudo_export_roundtrip(source_model, tmp_path, monkeypatch):
+    source, model = source_model
+    result_dir = tmp_path / "checkpoints"
+    result_dir.mkdir()
+    projection = model.model.layers[0].self_attn.q_proj
+    quantized = SPHPseudoQuantizedLinear(
+        projection, sample_size=64, kmeans_iterations=1, seed=0
+    )
+    torch.save(quantized.state_dict(), result_dir / "0.self_attn.q_proj.pt")
+    exported = tmp_path / "exported"
+    monkeypatch.setattr(
+        sys,
+        "argv",
+        [
+            "paroquant.cli.convert",
+            "--model", str(source),
+            "--result-dir", str(result_dir),
+            "--output-path", str(exported),
+            "--mode", "pseudo",
+        ],
+    )
+    convert.main()
+
+    restored = AutoModelForCausalLM.from_pretrained(exported, local_files_only=True).eval()
+    target = "model.layers.0.self_attn.q_proj.weight"
+    expected = quantized.pseudo_weight().detach()
+    for key, value in restored.state_dict().items():
+        torch.testing.assert_close(value, expected if key == target else model.state_dict()[key])
+    with torch.no_grad():
+        output = restored(torch.randint(0, 64, (1, 8)), use_cache=False)
+    assert torch.isfinite(output.logits).all()
+    assert "quantization_config" not in restored.config.to_dict()
diff --git a/tests/test_sphlinear.py b/tests/test_sphlinear.py
new file mode 100644
index 0000000..cc66474
--- /dev/null
+++ b/tests/test_sphlinear.py
@@ -0,0 +1,101 @@
+import pytest
+import torch
+from torch import nn
+
+from paroquant.optim.sphlinear import (
+    SPHPseudoQuantizedLinear,
+    direction_codebook_from_logits,
+    direction_logits_from_codebook,
+    radius_fake_quantize,
+)
+
+
+def test_angular_codebook_is_positive_unit_and_roundtrips():
+    logits = torch.linspace(-2, 2, 64 * 7).reshape(64, 7)
+    codebook = direction_codebook_from_logits(logits)
+    assert torch.all(codebook > 0)
+    torch.testing.assert_close(
+        codebook.norm(dim=-1),
+        torch.ones(64),
+        rtol=1e-6,
+        atol=1e-6,
+    )
+    restored = direction_codebook_from_logits(
+        direction_logits_from_codebook(codebook)
+    )
+    torch.testing.assert_close(restored, codebook, rtol=2e-5, atol=2e-5)
+
+
+def test_radius_fake_quant_has_16_levels_and_identity_ste():
+    radius = torch.linspace(0.1, 2, 32).reshape(2, 16).requires_grad_(True)
+    quantized = radius_fake_quantize(radius)
+    assert all(row.unique().numel() <= 16 for row in quantized)
+    quantized.sum().backward()
+    torch.testing.assert_close(radius.grad, torch.ones_like(radius))
+
+
+def test_sph_linear_forward_backward_and_state_roundtrip():
+    torch.manual_seed(0)
+    linear = nn.Linear(128, 4, bias=False)
+    module = SPHPseudoQuantizedLinear(
+        linear,
+        sample_size=64,
+        kmeans_iterations=2,
+        seed=0,
+    )
+    module.set_optim_enabled(radius=True, codebook=True)
+    x = torch.randn(3, 128, requires_grad=True)
+    indices_before = module.direction_indices.clone()
+    output = module(x)
+    output.square().mean().backward()
+    assert torch.isfinite(output).all()
+    assert torch.isfinite(module.radius_logits.grad).all()
+    assert torch.isfinite(module.angle_logits.grad).all()
+    assert module.radius_logits.grad.abs().sum() > 0
+    assert module.angle_logits.grad.abs().sum() > 0
+
+    restored = SPHPseudoQuantizedLinear.from_state_dict(module.state_dict())
+    torch.testing.assert_close(restored(x.detach()), output.detach())
+    torch.testing.assert_close(restored.pseudo_weight(), module.pseudo_weight())
+    torch.optim.Adam(
+        [module.radius_logits, module.angle_logits],
+        lr=1e-3,
+    ).step()
+    torch.testing.assert_close(module.direction_indices, indices_before)
+
+
+def test_eight_bit_codebook_uses_256_directions_and_two_bit_radii():
+    torch.manual_seed(0)
+    module = SPHPseudoQuantizedLinear(
+        nn.Linear(128, 16, bias=False),
+        sample_size=256,
+        kmeans_iterations=1,
+        codebook_bits=8,
+    )
+    assert module.angle_logits.shape == (256, 7)
+    assert module.direction_indices.dtype == torch.uint8
+    assert module.radius_bits.item() == 2
+
+    restored = SPHPseudoQuantizedLinear.from_state_dict(
+        module.state_dict(),
+        codebook_bits=8,
+    )
+    torch.testing.assert_close(restored.pseudo_weight(), module.pseudo_weight())
+    with pytest.raises(ValueError, match="does not match"):
+        SPHPseudoQuantizedLinear.from_state_dict(
+            module.state_dict(),
+            codebook_bits=6,
+        )
+
+
+def test_only_requested_parameter_groups_are_trainable():
+    module = SPHPseudoQuantizedLinear(
+        nn.Linear(128, 4, bias=True),
+        sample_size=64,
+        kmeans_iterations=1,
+    )
+    module.set_optim_enabled(radius=True, codebook=False)
+    assert module.radius_logits.requires_grad
+    assert not module.angle_logits.requires_grad
+    assert not module.bias.requires_grad
+    assert module.get_optim_params("radius") == [module.radius_logits]
