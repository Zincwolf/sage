@@ -0,0 +1,78 @@
+import pytest
+import torch
+from transformers import Qwen3Config, Qwen3ForCausalLM
+
+from paroquant.cli import optimize
+from paroquant.optim.sphlinear import SPHPseudoQuantizedLinear
+
+
+@pytest.mark.skipif(not torch.cuda.is_available(), reason="layerwise optimization uses CUDA")
+@pytest.mark.parametrize("codebook_bits", [6, 8])
+def test_text_sph_optimization_and_resume(tmp_path, monkeypatch, codebook_bits):
+    model_path = tmp_path / "source"
+    model = Qwen3ForCausalLM(
+        Qwen3Config(
+            vocab_size=64,
+            hidden_size=128,
+            intermediate_size=256,
+            num_hidden_layers=1,
+            num_attention_heads=4,
+            num_key_value_heads=2,
+            head_dim=32,
+        )
+    ).eval()
+    model.save_pretrained(model_path)
+    calibration_path = tmp_path / "calibration.pt"
+    torch.save(
+        {
+            "train": torch.randint(0, 64, (4, 8)),
+            "validation": torch.randint(0, 64, (2, 8)),
+        },
+        calibration_path,
+    )
+    config = optimize.Config(
+        model=str(model_path),
+        params=["radius:0.001,codebook:0.001"],
+        epochs=[1],
+        method="sphquant",
+        weight_decay=0.0,
+        betas=(0.9, 0.999),
+        eps=1e-8,
+        loss="mse",
+        optimizer="adam",
+        use_lr_scheduler=False,
+        group_size=128,
+        n_bit=2,
+        num_rotations=0,
+        datasets=[],
+        val_dataset="unused",
+        train_size=4,
+        validation_size=2,
+        batch_size=2,
+        seqlen=8,
+        calibration_path=str(calibration_path),
+        sph_sample_size=256,
+        sph_kmeans_iterations=1,
+        sph_codebook_bits=codebook_bits,
+        output_dir=str(tmp_path / "checkpoints"),
+        seed=0,
+    )
+    monkeypatch.setattr(optimize.simple_parsing, "parse", lambda *_args, **_kwargs: config)
+    optimize.main()
+
+    checkpoints = sorted((tmp_path / "checkpoints" / "source").glob("*.pt"))
+    assert len(checkpoints) == 7
+    for path in checkpoints:
+        restored = SPHPseudoQuantizedLinear.from_state_dict(
+            torch.load(path, map_location="cpu", weights_only=True),
+            codebook_bits=codebook_bits,
+        )
+        assert torch.isfinite(restored.pseudo_weight()).all()
+        assert restored.radius_bits.item() == 10 - codebook_bits
+
+    def reject_training(*_args, **_kwargs):
+        pytest.fail("resume must reuse completed layer checkpoints")
+
+    config.resume = True
+    monkeypatch.setattr(optimize, "optimize_module", reject_training)
+    optimize.main()
