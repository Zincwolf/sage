index 0000000..f8ef3ab
--- /dev/null
+++ b/tests/test_sph_qwen3.py
@@ -0,0 +1,54 @@
+import torch
+from transformers import Qwen3Config, Qwen3ForCausalLM
+
+from paroquant.optim.sphlinear import SPHPseudoQuantizedLinear
+from paroquant.optim.util import get_named_linears, set_module_by_name
+
+
+EXPECTED = {
+    "self_attn.q_proj",
+    "self_attn.k_proj",
+    "self_attn.v_proj",
+    "self_attn.o_proj",
+    "mlp.gate_proj",
+    "mlp.up_proj",
+    "mlp.down_proj",
+}
+
+
+def test_tiny_qwen3_layer_has_exact_sph_projection_coverage():
+    model = Qwen3ForCausalLM(
+        Qwen3Config(
+            vocab_size=64,
+            hidden_size=128,
+            intermediate_size=256,
+            num_hidden_layers=1,
+            num_attention_heads=4,
+            num_key_value_heads=2,
+            head_dim=32,
+        )
+    ).eval()
+    layer = model.model.layers[0]
+    linears = get_named_linears(layer)
+    assert set(linears) == EXPECTED
+    for name, linear in linears.items():
+        set_module_by_name(
+            layer,
+            name,
+            SPHPseudoQuantizedLinear(
+                linear,
+                sample_size=64,
+                kmeans_iterations=1,
+                seed=0,
+            ),
+        )
+    sph_linears = {
+        name: module
+        for name, module in layer.named_modules()
+        if isinstance(module, SPHPseudoQuantizedLinear)
+    }
+    assert set(sph_linears) == EXPECTED
+    with torch.no_grad():
+        logits = model(torch.randint(0, 64, (1, 8))).logits
+    assert logits.shape == (1, 8, 64)
+    assert torch.isfinite(logits).all()
