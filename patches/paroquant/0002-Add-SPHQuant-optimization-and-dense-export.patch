index 0000000..9771f43
--- /dev/null
+++ b/paroquant/optim/sphlinear.py
@@ -0,0 +1,360 @@
+from __future__ import annotations
+
+import math
+
+import torch
+import torch.nn.functional as F
+from torch import nn
+from torch.utils.checkpoint import checkpoint
+
+VECTOR_SIZE = 8
+GROUP_SIZE = 128
+INDEX_AND_RADIUS_BITS = 10
+DEFAULT_CODEBOOK_BITS = 6
+DEFAULT_RADIUS_BITS = INDEX_AND_RADIUS_BITS - DEFAULT_CODEBOOK_BITS
+ANGLE_EPS = 1e-4
+
+
+def softplus_inverse(value: torch.Tensor) -> torch.Tensor:
+    value = value.float().clamp_min(1e-8)
+    return value + torch.log(-torch.expm1(-value))
+
+
+def direction_codebook_from_logits(
+    angle_logits: torch.Tensor,
+    *,
+    angle_eps: float = ANGLE_EPS,
+) -> torch.Tensor:
+    if angle_logits.shape[-1] != VECTOR_SIZE - 1:
+        raise ValueError(f"Expected seven angular logits, got {angle_logits.shape}")
+    theta = angle_eps + (math.pi / 2 - 2 * angle_eps) * torch.sigmoid(
+        angle_logits.float()
+    )
+    sin_theta = torch.sin(theta)
+    cos_theta = torch.cos(theta)
+    prefix = torch.cumprod(sin_theta, dim=-1)
+    components = [cos_theta[..., :1]]
+    for index in range(1, VECTOR_SIZE - 1):
+        components.append(
+            prefix[..., index - 1 : index]
+            * cos_theta[..., index : index + 1]
+        )
+    components.append(prefix[..., -1:])
+    directions = torch.cat(components, dim=-1)
+    return directions / directions.norm(dim=-1, keepdim=True).clamp_min(1e-12)
+
+
+def direction_logits_from_codebook(codebook: torch.Tensor) -> torch.Tensor:
+    unit = codebook.float().clamp_min(0)
+    unit = unit / unit.norm(dim=-1, keepdim=True).clamp_min(1e-12)
+    theta = []
+    for index in range(VECTOR_SIZE - 1):
+        denominator = unit[..., index:].norm(dim=-1).clamp_min(1e-12)
+        theta.append(torch.acos((unit[..., index] / denominator).clamp(0, 1)))
+    theta = torch.stack(theta, dim=-1).clamp(
+        min=ANGLE_EPS,
+        max=math.pi / 2 - ANGLE_EPS,
+    )
+    normalized = (theta - ANGLE_EPS) / (math.pi / 2 - 2 * ANGLE_EPS)
+    return torch.logit(normalized.clamp(1e-7, 1 - 1e-7))
+
+
+def radius_fake_quantize(
+    radius: torch.Tensor,
+    *,
+    bits: int = DEFAULT_RADIUS_BITS,
+    group_size: int = GROUP_SIZE,
+) -> torch.Tensor:
+    vectors_per_group = group_size // VECTOR_SIZE
+    if radius.ndim != 2 or radius.shape[1] % vectors_per_group:
+        raise ValueError(
+            f"Radius shape must be [rows, multiple of {vectors_per_group}], "
+            f"got {tuple(radius.shape)}"
+        )
+    groups = radius.float().reshape(radius.shape[0], -1, vectors_per_group)
+    detached = groups.detach()
+    minimum = detached.amin(dim=-1, keepdim=True)
+    maximum = detached.amax(dim=-1, keepdim=True)
+    levels = (1 << bits) - 1
+    scale = (maximum - minimum) / levels
+    safe_scale = torch.where(scale > 0, scale, torch.ones_like(scale))
+    codes = torch.round((detached - minimum) / safe_scale).clamp(0, levels)
+    dequantized = minimum + codes * safe_scale
+    dequantized = torch.where(scale > 0, dequantized, minimum)
+    dequantized = dequantized.reshape_as(radius)
+    return radius + (dequantized - radius).detach()
+
+
+@torch.no_grad()
+def assign_directions(
+    directions: torch.Tensor,
+    codebook: torch.Tensor,
+    *,
+    chunk_size: int = 262144,
+) -> torch.Tensor:
+    assignments = torch.empty(
+        directions.shape[0],
+        dtype=torch.long,
+        device=directions.device,
+    )
+    for start in range(0, directions.shape[0], chunk_size):
+        end = min(start + chunk_size, directions.shape[0])
+        assignments[start:end] = (
+            directions[start:end].float() @ codebook.float().T
+        ).argmax(dim=1)
+    return assignments
+
+
+@torch.no_grad()
+def spherical_kmeans(
+    directions: torch.Tensor,
+    radius: torch.Tensor,
+    *,
+    sample_size: int = 65536,
+    iterations: int = 20,
+    num_directions: int = 1 << DEFAULT_CODEBOOK_BITS,
+    seed: int = 0,
+) -> torch.Tensor:
+    if directions.ndim != 2 or directions.shape[1] != VECTOR_SIZE:
+        raise ValueError(f"Expected [N, 8] directions, got {directions.shape}")
+    sample_count = min(sample_size, directions.shape[0])
+    if sample_count < num_directions:
+        raise ValueError(
+            f"Need at least {num_directions} sampled vectors for the direction "
+            f"codebook, got {sample_count}"
+        )
+    weights = radius.float().square()
+    if float(weights.sum()) == 0:
+        probabilities = torch.full_like(weights, 1 / weights.numel())
+    else:
+        probabilities = weights / weights.sum()
+    generator = torch.Generator(device=directions.device).manual_seed(seed)
+    sampled_ids = torch.multinomial(
+        probabilities,
+        sample_count,
+        replacement=False,
+        generator=generator,
+    )
+    sampled = directions[sampled_ids].float()
+    initial = torch.randperm(
+        sample_count,
+        device=directions.device,
+        generator=generator,
+    )[:num_directions]
+    centers = sampled[initial].clone()
+    centers /= centers.norm(dim=1, keepdim=True).clamp_min(1e-12)
+    for _ in range(iterations):
+        assignments = assign_directions(sampled, centers)
+        sums = torch.zeros_like(centers)
+        counts = torch.zeros(
+            num_directions,
+            dtype=torch.long,
+            device=centers.device,
+        )
+        sums.index_add_(0, assignments, sampled)
+        counts.index_add_(0, assignments, torch.ones_like(assignments))
+        nonempty = counts > 0
+        centers[nonempty] = sums[nonempty] / counts[nonempty, None]
+        centers /= centers.norm(dim=1, keepdim=True).clamp_min(1e-12)
+    return centers
+
+
+@torch.no_grad()
+def initialize_spherical_weight(
+    weight: torch.Tensor,
+    *,
+    sample_size: int = 65536,
+    kmeans_iterations: int = 20,
+    codebook_bits: int = DEFAULT_CODEBOOK_BITS,
+    seed: int = 0,
+) -> dict[str, torch.Tensor]:
+    if weight.ndim != 2 or weight.shape[1] % GROUP_SIZE:
+        raise ValueError(
+            f"Expected 2D weight with input divisible by {GROUP_SIZE}, "
+            f"got {tuple(weight.shape)}"
+        )
+    positive = weight.float().abs().reshape(-1, VECTOR_SIZE)
+    radius = positive.norm(dim=1)
+    directions = positive / radius[:, None].clamp_min(1e-12)
+    zero = radius == 0
+    if bool(zero.any()):
+        directions[zero] = 1 / math.sqrt(VECTOR_SIZE)
+    codebook = spherical_kmeans(
+        directions,
+        radius,
+        sample_size=sample_size,
+        iterations=kmeans_iterations,
+        num_directions=1 << codebook_bits,
+        seed=seed,
+    )
+    indices = assign_directions(directions, codebook)
+    selected = codebook[indices]
+    ls_radius = (positive * selected).sum(dim=1).clamp_min(1e-8)
+    vector_shape = (weight.shape[0], weight.shape[1] // VECTOR_SIZE)
+    return {
+        "signs": torch.where(weight >= 0, 1, -1).to(torch.int8),
+        "direction_indices": indices.reshape(vector_shape).to(torch.uint8),
+        "radius_logits": softplus_inverse(ls_radius).reshape(vector_shape),
+        "angle_logits": direction_logits_from_codebook(codebook),
+    }
+
+
+def materialize_spherical_weight(
+    signs: torch.Tensor,
+    direction_indices: torch.Tensor,
+    radius_logits: torch.Tensor,
+    angle_logits: torch.Tensor,
+    radius_bits: torch.Tensor,
+    group_size: torch.Tensor,
+) -> torch.Tensor:
+    codebook = direction_codebook_from_logits(angle_logits)
+    directions = codebook[direction_indices.long()]
+    radius = radius_fake_quantize(
+        F.softplus(radius_logits.float()),
+        bits=int(radius_bits),
+        group_size=int(group_size),
+    )
+    signed = signs.reshape(signs.shape[0], -1, VECTOR_SIZE).float()
+    return (signed * directions * radius[..., None]).reshape_as(signs)
+
+
+class SPHPseudoQuantizedLinear(nn.Module):
+    def __init__(
+        self,
+        linear: nn.Linear,
+        *,
+        sample_size: int = 65536,
+        kmeans_iterations: int = 20,
+        codebook_bits: int = DEFAULT_CODEBOOK_BITS,
+        seed: int = 0,
+        initialized: dict[str, torch.Tensor] | None = None,
+    ) -> None:
+        super().__init__()
+        if not 1 <= codebook_bits <= 8:
+            raise ValueError("codebook_bits must be within [1, 8]")
+        self.enable_checkpoint = False
+        if initialized is None:
+            initialized = initialize_spherical_weight(
+                linear.weight,
+                sample_size=sample_size,
+                kmeans_iterations=kmeans_iterations,
+                codebook_bits=codebook_bits,
+                seed=seed,
+            )
+        self.register_buffer("signs", initialized["signs"].contiguous())
+        self.register_buffer(
+            "direction_indices",
+            initialized["direction_indices"].contiguous(),
+        )
+        self.radius_logits = nn.Parameter(
+            initialized["radius_logits"].float().contiguous()
+        )
+        self.angle_logits = nn.Parameter(
+            initialized["angle_logits"].float().contiguous()
+        )
+        if linear.bias is None:
+            self.register_buffer("bias", None)
+        else:
+            self.bias = nn.Parameter(linear.bias.detach().clone())
+            self.bias.requires_grad_(False)
+        self.register_buffer(
+            "radius_bits",
+            torch.tensor(INDEX_AND_RADIUS_BITS - codebook_bits, dtype=torch.int32),
+        )
+        self.register_buffer(
+            "group_size",
+            torch.tensor(GROUP_SIZE, dtype=torch.int32),
+        )
+        self.register_buffer(
+            "sphquant_version",
+            torch.tensor(1, dtype=torch.int32),
+        )
+
+    def checkpointed(self, fn, *args):
+        if torch.is_grad_enabled() and self.enable_checkpoint:
+            return checkpoint(fn, *args, use_reentrant=False)
+        return fn(*args)
+
+    def materialized_weight(self) -> torch.Tensor:
+        return self.checkpointed(
+            materialize_spherical_weight,
+            self.signs,
+            self.direction_indices,
+            self.radius_logits,
+            self.angle_logits,
+            self.radius_bits,
+            self.group_size,
+        )
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        weight = self.materialized_weight().to(x.dtype)
+        return F.linear(x, weight, self.bias)
+
+    def set_optim_enabled(
+        self,
+        *,
+        radius: bool = False,
+        codebook: bool = False,
+        **unexpected,
+    ) -> None:
+        if unexpected:
+            raise ValueError(f"Unknown SPHQuant parameters: {sorted(unexpected)}")
+        self.radius_logits.requires_grad_(radius)
+        self.angle_logits.requires_grad_(codebook)
+        if self.bias is not None:
+            self.bias.requires_grad_(False)
+
+    def get_optim_params(self, name: str) -> list[nn.Parameter]:
+        if name == "radius":
+            return [self.radius_logits]
+        if name == "codebook":
+            return [self.angle_logits]
+        raise ValueError(f"Unknown SPHQuant parameter group: {name}")
+
+    @torch.no_grad()
+    def pseudo_weight(self) -> torch.Tensor:
+        return self.materialized_weight().detach()
+
+    @torch.no_grad()
+    def reset_angles_by_mask(self) -> None:
+        return None
+
+    @classmethod
+    def from_state_dict(
+        cls,
+        state_dict: dict[str, torch.Tensor],
+        *,
+        codebook_bits: int | None = None,
+    ) -> "SPHPseudoQuantizedLinear":
+        signs = state_dict["signs"]
+        num_directions = state_dict["angle_logits"].shape[0]
+        checkpoint_codebook_bits = num_directions.bit_length() - 1
+        if 1 << checkpoint_codebook_bits != num_directions:
+            raise ValueError(
+                f"Direction codebook size must be a power of two, got {num_directions}"
+            )
+        if codebook_bits is not None and codebook_bits != checkpoint_codebook_bits:
+            raise ValueError(
+                f"Configured {codebook_bits}-bit direction codebook does not match "
+                f"{checkpoint_codebook_bits}-bit checkpoint"
+            )
+        linear = nn.Linear(
+            signs.shape[1],
+            signs.shape[0],
+            bias="bias" in state_dict and state_dict["bias"] is not None,
+            device=signs.device,
+            dtype=torch.float32,
+        )
+        initialized = {
+            "signs": signs,
+            "direction_indices": state_dict["direction_indices"],
+            "radius_logits": state_dict["radius_logits"],
+            "angle_logits": state_dict["angle_logits"],
+        }
+        module = cls(
+            linear,
+            codebook_bits=checkpoint_codebook_bits,
+            initialized=initialized,
+        )
+        module.load_state_dict(state_dict)
+        return module
