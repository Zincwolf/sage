index 0000000..f44ac1b
--- /dev/null
+++ b/tests/test_sph_launcher.py
@@ -0,0 +1,71 @@
+import os
+import subprocess
+import tempfile
+import unittest
+from pathlib import Path
+
+
+REPO_ROOT = Path(__file__).resolve().parents[1]
+LAUNCHER = REPO_ROOT / "experiments" / "sphquant" / "qwen3_4b.sh"
+QWEN35_LAUNCHER = REPO_ROOT / "experiments" / "sphquant" / "qwen3_5_9b.sh"
+
+
+class SphLauncherTest(unittest.TestCase):
+    def dry_run(self, mode: str) -> str:
+        with tempfile.TemporaryDirectory() as tmp:
+            root = Path(tmp)
+            model = root / "model"
+            model.mkdir()
+            (model / "config.json").write_text("{}\n")
+            env = {
+                **os.environ,
+                "MODEL": str(model),
+                "CALIBRATION": str(root / "calibration.pt"),
+                "OUTPUT_DIR": str(root / "output"),
+                "MODE": mode,
+                "SMOKE": "1",
+                "DRY_RUN": "1",
+            }
+            return subprocess.run(
+                ["bash", str(LAUNCHER)],
+                check=True,
+                capture_output=True,
+                env=env,
+                text=True,
+            ).stdout
+
+    def test_smoke_cache_shards_divide_captured_batches(self):
+        self.assertIn("--cache-shards 2", self.dry_run("init"))
+        self.assertIn("--cache-shards 5", self.dry_run("layerwise"))
+
+    def test_qwen35_launcher_uses_multimodal_bfloat16_protocol(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            root = Path(tmp)
+            model = root / "model"
+            model.mkdir()
+            (model / "config.json").write_text("{}\n")
+            env = {
+                **os.environ,
+                "MODEL": str(model),
+                "CALIBRATION": str(root / "coco_manifest.json"),
+                "OUTPUT_DIR": str(root / "output"),
+                "MODE": "layerwise",
+                "SMOKE": "1",
+                "DRY_RUN": "1",
+            }
+            output = subprocess.run(
+                ["bash", str(QWEN35_LAUNCHER)],
+                check=True,
+                capture_output=True,
+                env=env,
+                text=True,
+            ).stdout
+        self.assertIn("--multimodal-calibration-path", output)
+        self.assertIn("--model-dtype bfloat16", output)
+        self.assertIn("--max-layers 1", output)
+        self.assertIn("--calibration-limit 80", output)
+        self.assertIn("--cache-shards 5", output)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_sph_qwen3.py b/tests/test_sph_qwen3.py
new file mode 100644
index 0000000..f8ef3ab
--- /dev/null
+++ b/tests/test_sph_qwen3.py
@@ -0,0 +1,54 @@
+import torch
+from transformers import Qwen3Config, Qwen3ForCausalLM
+
+from paroquant.optim.sphlinear import SPHPseudoQuantizedLinear
+from paroquant.optim.util import get_named_linears, set_module_by_name
+
+
+EXPECTED = {
+    "self_attn.q_proj",
+    "self_attn.k_proj",
+    "self_attn.v_proj",
+    "self_attn.o_proj",
+    "mlp.gate_proj",
+    "mlp.up_proj",
+    "mlp.down_proj",
+}
+
+
+def test_tiny_qwen3_layer_has_exact_sph_projection_coverage():
+    model = Qwen3ForCausalLM(
+        Qwen3Config(
+            vocab_size=64,
+            hidden_size=128,
+            intermediate_size=256,
+            num_hidden_layers=1,
+            num_attention_heads=4,
+            num_key_value_heads=2,
+            head_dim=32,
+        )
+    ).eval()
+    layer = model.model.layers[0]
+    linears = get_named_linears(layer)
+    assert set(linears) == EXPECTED
+    for name, linear in linears.items():
+        set_module_by_name(
+            layer,
+            name,
+            SPHPseudoQuantizedLinear(
+                linear,
+                sample_size=64,
+                kmeans_iterations=1,
+                seed=0,
+            ),
+        )
+    sph_linears = {
+        name: module
+        for name, module in layer.named_modules()
+        if isinstance(module, SPHPseudoQuantizedLinear)
+    }
+    assert set(sph_linears) == EXPECTED
+    with torch.no_grad():
+        logits = model(torch.randint(0, 64, (1, 8))).logits
+    assert logits.shape == (1, 8, 64)
+    assert torch.isfinite(logits).all()
