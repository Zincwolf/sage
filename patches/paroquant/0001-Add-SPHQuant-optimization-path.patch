+def test_sph_linear_forward_backward_and_state_roundtrip():
+    torch.manual_seed(0)
+    linear = nn.Linear(128, 4, bias=False)
+    module = SPHPseudoQuantizedLinear(
+        linear,
+        sample_size=64,
+        kmeans_iterations=2,
+        seed=0,
+    )
+    module.set_optim_enabled(radius=True, codebook=True)
+    x = torch.randn(3, 128, requires_grad=True)
+    indices_before = module.direction_indices.clone()
+    output = module(x)
+    output.square().mean().backward()
+    assert torch.isfinite(output).all()
+    assert torch.isfinite(module.radius_logits.grad).all()
+    assert torch.isfinite(module.angle_logits.grad).all()
+    assert module.radius_logits.grad.abs().sum() > 0
+    assert module.angle_logits.grad.abs().sum() > 0
+
+    restored = SPHPseudoQuantizedLinear.from_state_dict(module.state_dict())
+    torch.testing.assert_close(restored(x.detach()), output.detach())
+    torch.testing.assert_close(restored.pseudo_weight(), module.pseudo_weight())
+    torch.optim.Adam(
+        [module.radius_logits, module.angle_logits],
+        lr=1e-3,
+    ).step()
+    torch.testing.assert_close(module.direction_indices, indices_before)
