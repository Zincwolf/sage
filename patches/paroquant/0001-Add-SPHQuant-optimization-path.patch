new file mode 100644
index 0000000..61c8b0b
--- /dev/null
+++ b/paroquant/optim/multimodal.py
@@ -0,0 +1,109 @@
+from __future__ import annotations
+
+import json
+import math
+from collections.abc import Iterator
+from pathlib import Path
+
+import torch
+from PIL import Image
+from transformers import AutoProcessor
+
+
+def _conversation(record: dict, image: Image.Image) -> list[dict]:
+    turns = record["conversations"]
+    if len(turns) != 2 or turns[0]["from"] != "human" or turns[1]["from"] != "gpt":
+        raise ValueError(f"Unexpected ShareGPT4V conversation for {record['id']}")
+    prompt = turns[0]["value"].replace("<image>", "").strip()
+    caption = turns[1]["value"].strip()
+    return [
+        {
+            "role": "user",
+            "content": [
+                {"type": "image", "image": image},
+                {"type": "text", "text": prompt},
+            ],
+        },
+        {
+            "role": "assistant",
+            "content": [{"type": "text", "text": caption}],
+        },
+    ]
+
+
+class CocoCalibrationBatches:
+    """Re-iterable processor batches backed by a frozen COCO manifest."""
+
+    def __init__(
+        self,
+        manifest_path: str | Path,
+        *,
+        model_path: str | Path,
+        split: str,
+        batch_size: int,
+        limit: int | None = None,
+    ) -> None:
+        if split not in {"train", "validation"}:
+            raise ValueError(f"Unsupported split: {split}")
+        if batch_size <= 0:
+            raise ValueError("batch_size must be positive")
+        manifest_path = Path(manifest_path)
+        manifest = json.loads(manifest_path.read_text())
+        self.records = []
+        for source_record in manifest["records"]:
+            if source_record["split"] != split:
+                continue
+            record = dict(source_record)
+            image_path = Path(record["image"])
+            if not image_path.is_absolute():
+                image_path = manifest_path.parent / image_path
+            record["image"] = str(image_path)
+            self.records.append(record)
+        if limit is not None:
+            self.records = self.records[:limit]
+        if not self.records:
+            raise ValueError(f"No {split} samples found in {manifest_path}")
+        self.batch_size = min(batch_size, len(self.records))
+        if len(self.records) % self.batch_size:
+            raise ValueError(
+                f"{split} sample count {len(self.records)} must be divisible by "
+                f"batch size {self.batch_size}"
+            )
+        self.processor = AutoProcessor.from_pretrained(
+            model_path,
+            trust_remote_code=True,
+            local_files_only=True,
+        )
+        tokenizer = getattr(self.processor, "tokenizer", None)
+        if tokenizer is not None and tokenizer.pad_token_id is None:
+            tokenizer.pad_token = tokenizer.eos_token
+
+    def __len__(self) -> int:
+        return math.ceil(len(self.records) / self.batch_size)
+
+    def __iter__(self) -> Iterator[dict[str, torch.Tensor]]:
+        for start in range(0, len(self.records), self.batch_size):
+            records = self.records[start : start + self.batch_size]
+            images = [Image.open(record["image"]).convert("RGB") for record in records]
+            try:
+                conversations = [
+                    _conversation(record, image)
+                    for record, image in zip(records, images)
+                ]
+                batch = self.processor.apply_chat_template(
+                    conversations,
+                    tokenize=True,
+                    add_generation_prompt=False,
+                    enable_thinking=False,
+                    processor_kwargs={"padding": True},
+                    return_dict=True,
+                    return_tensors="pt",
+                )
+            finally:
+                for image in images:
+                    image.close()
+            yield {
+                key: value
+                for key, value in batch.items()
+                if isinstance(value, torch.Tensor)
+            }
