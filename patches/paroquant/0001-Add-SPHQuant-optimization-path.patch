+import torch
+from torch import nn
+
+from paroquant.optim.sphlinear import (
+    SPHPseudoQuantizedLinear,
+    direction_codebook_from_logits,
+    direction_logits_from_codebook,
+    radius_fake_quantize,
+)
+
+
+def test_angular_codebook_is_positive_unit_and_roundtrips():
+    logits = torch.linspace(-2, 2, 64 * 7).reshape(64, 7)
+    codebook = direction_codebook_from_logits(logits)
+    assert torch.all(codebook > 0)
+    torch.testing.assert_close(
+        codebook.norm(dim=-1),
+        torch.ones(64),
+        rtol=1e-6,
+        atol=1e-6,
+    )
+    restored = direction_codebook_from_logits(
+        direction_logits_from_codebook(codebook)
+    )
+    torch.testing.assert_close(restored, codebook, rtol=2e-5, atol=2e-5)
