+import json
+
+import torch
+from safetensors.torch import save_file
+
+from paroquant.cli.convert import _append_missing_source_weights
+
+
+def test_pseudo_export_preserves_only_requested_quantized_weights(tmp_path):
+    shard = tmp_path / "model-00001-of-00001.safetensors"
+    source = {
+        "model.layers.0.proj.weight": torch.ones(2, 2),
+        "model.visual.proj.weight": torch.full((2, 2), 2.0),
+        "mtp.layers.0.proj.weight": torch.full((2, 2), 3.0),
+    }
+    save_file(source, shard)
+    (tmp_path / "model.safetensors.index.json").write_text(
+        json.dumps(
+            {
+                "metadata": {},
+                "weight_map": {name: shard.name for name in source},
+            }
+        )
+    )
+    model_state = {
+        "model.layers.0.proj.weight": torch.zeros(2, 2),
+        "model.visual.proj.weight": torch.zeros(2, 2),
+        "runtime.buffer": torch.tensor([4.0]),
+    }
+    merged = _append_missing_source_weights(
+        model_state,
+        tmp_path,
+        {"model.layers.0.proj.weight"},
+    )
+    torch.testing.assert_close(
+        merged["model.layers.0.proj.weight"],
+        torch.zeros(2, 2),
+    )
+    torch.testing.assert_close(
+        merged["model.visual.proj.weight"],
+        source["model.visual.proj.weight"],
+    )
+    torch.testing.assert_close(
+        merged["mtp.layers.0.proj.weight"],
+        source["mtp.layers.0.proj.weight"],
+    )
+    torch.testing.assert_close(merged["runtime.buffer"], torch.tensor([4.0]))
