diff --git a/experiments/sphquant/export_qwen3_4b.sh b/experiments/sphquant/export_qwen3_4b.sh
new file mode 100755
index 0000000..490862b
--- /dev/null
+++ b/experiments/sphquant/export_qwen3_4b.sh
@@ -0,0 +1,43 @@
+#!/usr/bin/env bash
+
+set -euo pipefail
+
+SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
+PAROQUANT_ROOT="$(cd -- "${SCRIPT_DIR}/../.." && pwd)"
+WEIGHT_VQ_ROOT="$(cd -- "${PAROQUANT_ROOT}/.." && pwd)"
+WORK="${WORK:-$(cd -- "${WEIGHT_VQ_ROOT}/../.." && pwd)}"
+MODEL="${MODEL:-${WORK}/pretrained/Qwen3-4B-Instruct-2507}"
+MODE="${MODE:-layerwise}" # init | layerwise
+OUTPUT_ROOT="${OUTPUT_ROOT:-${WORK}/checkpoint/weight-vq/Qwen3-4B-Instruct-2507/sphquant}"
+DRY_RUN="${DRY_RUN:-0}"
+
+case "$MODE" in
+  init)
+    RESULT_ROOT="${RESULT_ROOT:-${OUTPUT_ROOT}/no_tuning}"
+    HF_OUTPUT="${HF_OUTPUT:-${OUTPUT_ROOT}/hf_no_tuning}"
+    ;;
+  layerwise)
+    RESULT_ROOT="${RESULT_ROOT:-${OUTPUT_ROOT}/layerwise}"
+    HF_OUTPUT="${HF_OUTPUT:-${OUTPUT_ROOT}/hf_layerwise}"
+    ;;
+  *)
+    echo "ERROR: MODE must be init or layerwise" >&2
+    exit 2
+    ;;
+esac
+RESULT_DIR="${RESULT_ROOT}/$(basename "$MODEL")"
+
+COMMAND=(
+  python -m paroquant.cli.convert
+  --model "$MODEL"
+  --result-dir "$RESULT_DIR"
+  --output-path "$HF_OUTPUT"
+  --mode pseudo
+)
+printf 'COMMAND:'
+printf ' %q' "${COMMAND[@]}"
+printf '\n'
+if [[ "$DRY_RUN" == "1" ]]; then
+  exit 0
+fi
+exec "${COMMAND[@]}"
diff --git a/experiments/sphquant/qwen3_4b.sh b/experiments/sphquant/qwen3_4b.sh
new file mode 100755
index 0000000..67e8cc8
--- /dev/null
+++ b/experiments/sphquant/qwen3_4b.sh
@@ -0,0 +1,115 @@
+#!/usr/bin/env bash
+
+set -euo pipefail
+
+SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
+PAROQUANT_ROOT="$(cd -- "${SCRIPT_DIR}/../.." && pwd)"
+WEIGHT_VQ_ROOT="$(cd -- "${PAROQUANT_ROOT}/.." && pwd)"
+WORK="${WORK:-$(cd -- "${WEIGHT_VQ_ROOT}/../.." && pwd)}"
+MODEL="${MODEL:-${WORK}/pretrained/Qwen3-4B-Instruct-2507}"
+CALIBRATION="${CALIBRATION:-${WEIGHT_VQ_ROOT}/benchmark/qwen3-4b/data/calibration.pt}"
+MODE="${MODE:-layerwise}" # init | layerwise
+CACHE_SHARDS="${CACHE_SHARDS:-}"
+OUTPUT_ROOT="${OUTPUT_ROOT:-${WORK}/checkpoint/weight-vq/Qwen3-4B-Instruct-2507/sphquant}"
+USE_WANDB="${USE_WANDB:-0}"
+DRY_RUN="${DRY_RUN:-0}"
+SMOKE="${SMOKE:-0}"
+BOUNDED="${BOUNDED:-0}"
+SPH_SAMPLE_SIZE="${SPH_SAMPLE_SIZE:-65536}"
+SPH_KMEANS_ITERATIONS="${SPH_KMEANS_ITERATIONS:-20}"
+EXTRA_ARGS=()
+if [[ "$SMOKE" == "1" ]]; then
+  SPH_SAMPLE_SIZE=512
+  SPH_KMEANS_ITERATIONS=2
+  EXTRA_ARGS=(--max-layers 1 --calibration-limit 32)
+fi
+
+case "$MODE" in
+  init)
+    EPOCHS="${EPOCHS_OVERRIDE:-0}"
+    OUTPUT_DIR="${OUTPUT_DIR:-${OUTPUT_ROOT}/no_tuning}"
+    ;;
+  layerwise)
+    EPOCHS="${EPOCHS_OVERRIDE:-20}"
+    OUTPUT_DIR="${OUTPUT_DIR:-${OUTPUT_ROOT}/layerwise}"
+    ;;
+  *)
+    echo "ERROR: MODE must be init or layerwise" >&2
+    exit 2
+    ;;
+esac
+if [[ "$SMOKE" == "1" && "$MODE" == "layerwise" ]]; then
+  # 80 samples / batch 16 * 20 epochs = exactly 100 optimizer steps.
+  EXTRA_ARGS=(--max-layers 1 --calibration-limit 80)
+fi
+if [[ "$BOUNDED" == "1" ]]; then
+  SPH_SAMPLE_SIZE="${SPH_SAMPLE_SIZE_OVERRIDE:-512}"
+  SPH_KMEANS_ITERATIONS="${SPH_KMEANS_ITERATIONS_OVERRIDE:-2}"
+  EXTRA_ARGS=(--calibration-limit "${CALIBRATION_LIMIT:-16}")
+fi
+if [[ -z "$CACHE_SHARDS" ]]; then
+  CACHE_SHARDS=8
+  if [[ "$SMOKE" == "1" ]]; then
+    CACHE_SHARDS=2
+    if [[ "$MODE" == "layerwise" ]]; then
+      CACHE_SHARDS=5
+    fi
+  fi
+  if [[ "$BOUNDED" == "1" ]]; then
+    CACHE_SHARDS=1
+  fi
+fi
+
+[[ -f "${MODEL}/config.json" ]] || {
+  echo "ERROR: model not found: $MODEL" >&2
+  exit 1
+}
+[[ -f "$CALIBRATION" || "$DRY_RUN" == "1" ]] || {
+  echo "ERROR: calibration artifact not found: $CALIBRATION" >&2
+  exit 1
+}
+
+COMMAND=(
+  python -m paroquant.cli.optimize
+  --method sphquant
+  --model "$MODEL"
+  --params "radius:0.001,codebook:0.001"
+  --epochs "$EPOCHS"
+  --weight-decay 0
+  --betas 0.9 0.999
+  --eps 1e-8
+  --loss mse
+  --optimizer adam
+  --use-lr-scheduler false
+  --group-size 128
+  --n-bit 2
+  --num-rotations 0
+  --datasets wikitext2 c4 redpajama
+  --val-dataset pileval
+  --train-size 1920
+  --validation-size 128
+  --batch-size 16
+  --val-batch-size 16
+  --gradient-accumulation-steps 1
+  --seqlen 2048
+  --calibration-path "$CALIBRATION"
+  --sph-sample-size "$SPH_SAMPLE_SIZE"
+  --sph-kmeans-iterations "$SPH_KMEANS_ITERATIONS"
+  --cache-shards "$CACHE_SHARDS"
+  --output-dir "$OUTPUT_DIR"
+  --resume true
+  --checkpointing true
+  --seed 0
+  "${EXTRA_ARGS[@]}"
+)
+if [[ "$USE_WANDB" == "1" ]]; then
+  COMMAND+=(--use-wandb true)
+fi
+
+printf 'COMMAND:'
+printf ' %q' "${COMMAND[@]}"
+printf '\n'
+if [[ "$DRY_RUN" == "1" ]]; then
+  exit 0
+fi
+exec "${COMMAND[@]}"
