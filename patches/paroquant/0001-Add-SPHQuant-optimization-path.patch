+#!/usr/bin/env bash
+
+set -euo pipefail
+
+SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
+WEIGHT_VQ_ROOT="${WEIGHT_VQ_ROOT:-$(cd -- "${SCRIPT_DIR}/../../.." && pwd)}"
+WORK="${WORK:-$(cd -- "${WEIGHT_VQ_ROOT}/../.." && pwd)}"
+MODEL="${MODEL:-${WORK}/pretrained/Qwen3.5-9B}"
+CALIBRATION="${CALIBRATION:-${WEIGHT_VQ_ROOT}/benchmark/qwen3.5-9b/data/coco_calibration_manifest.json}"
+MODE="${MODE:-layerwise}" # init | layerwise
+OUTPUT_ROOT="${OUTPUT_ROOT:-${WORK}/pretrained/weight-vq-qwen3.5-9b/sphquant}"
+OUTPUT_DIR="${OUTPUT_DIR:-}"
+CACHE_SHARDS="${CACHE_SHARDS:-}"
+USE_WANDB="${USE_WANDB:-0}"
+DRY_RUN="${DRY_RUN:-0}"
+SMOKE="${SMOKE:-0}"
+
+TRAIN_BATCH_SIZE=16
+VAL_BATCH_SIZE=16
+SPH_SAMPLE_SIZE=65536
+SPH_KMEANS_ITERATIONS=20
+EXTRA_ARGS=()
+if [[ "$SMOKE" == "1" ]]; then
+  TRAIN_BATCH_SIZE=4
+  VAL_BATCH_SIZE=4
+  SPH_SAMPLE_SIZE=512
+  SPH_KMEANS_ITERATIONS=2
+  EXTRA_ARGS=(--max-layers 1 --calibration-limit 32)
+fi
+
+case "$MODE" in
+  init)
+    EPOCHS=0
+    OUTPUT_DIR="${OUTPUT_DIR:-${OUTPUT_ROOT}/no_tuning}"
+    ;;
+  layerwise)
+    EPOCHS=20
+    OUTPUT_DIR="${OUTPUT_DIR:-${OUTPUT_ROOT}/layerwise}"
+    ;;
+  *)
+    echo "ERROR: MODE must be init or layerwise" >&2
+    exit 2
+    ;;
+esac
+if [[ "$SMOKE" == "1" && "$MODE" == "layerwise" ]]; then
+  EXTRA_ARGS=(--max-layers 1 --calibration-limit 80)
+fi
+if [[ -z "$CACHE_SHARDS" ]]; then
+  CACHE_SHARDS=8
+  if [[ "$SMOKE" == "1" && "$MODE" == "layerwise" ]]; then
+    CACHE_SHARDS=5
+  fi
+fi
+
+[[ -f "${MODEL}/config.json" ]] || {
+  echo "ERROR: model not found: $MODEL" >&2
+  exit 1
+}
+[[ -f "$CALIBRATION" || "$DRY_RUN" == "1" ]] || {
+  echo "ERROR: COCO calibration manifest not found: $CALIBRATION" >&2
+  exit 1
+}
+
+COMMAND=(
+  python -m paroquant.cli.optimize
+  --method sphquant
+  --model "$MODEL"
+  --params "radius:0.001,codebook:0.001"
+  --epochs "$EPOCHS"
+  --weight-decay 0
+  --betas 0.9 0.999
+  --eps 1e-8
+  --loss mse
+  --optimizer adam
+  --use-lr-scheduler false
+  --group-size 128
+  --n-bit 2
+  --num-rotations 0
+  --datasets coco
+  --val-dataset coco
+  --train-size 1920
+  --validation-size 128
+  --batch-size "$TRAIN_BATCH_SIZE"
+  --val-batch-size "$VAL_BATCH_SIZE"
+  --gradient-accumulation-steps 1
+  --seqlen 2048
+  --multimodal-calibration-path "$CALIBRATION"
+  --sph-sample-size "$SPH_SAMPLE_SIZE"
+  --sph-kmeans-iterations "$SPH_KMEANS_ITERATIONS"
+  --model-dtype bfloat16
+  --cache-shards "$CACHE_SHARDS"
+  --output-dir "$OUTPUT_DIR"
+  --resume true
+  --checkpointing true
+  --seed 0
+  "${EXTRA_ARGS[@]}"
+)
+if [[ "$USE_WANDB" == "1" ]]; then
+  COMMAND+=(--use-wandb true)
+fi
+
+printf 'COMMAND:'
+printf ' %q' "${COMMAND[@]}"
+printf '\n'
+if [[ "$DRY_RUN" == "1" ]]; then
+  exit 0
+fi
+exec "${COMMAND[@]}"
