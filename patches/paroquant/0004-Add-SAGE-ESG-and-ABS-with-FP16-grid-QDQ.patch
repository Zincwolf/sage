+@torch.no_grad()
+def assign_directions_weighted(
+    positive: torch.Tensor,
+    codebook: torch.Tensor,
+    weights: torch.Tensor,
+    *,
+    chunk_size: int = 32768,
+) -> torch.Tensor:
+    """Minimize weighted error after fitting a continuous radius per codeword."""
+    assignments = torch.empty(positive.shape[0], dtype=torch.long, device=positive.device)
+    transposed = codebook.float().T
+    squared = codebook.float().square().T
+    for start in range(0, positive.shape[0], chunk_size):
+        end = start + chunk_size
+        block_weights = weights[start:end].float()
+        numerator = ((block_weights * positive[start:end].float()) @ transposed).square()
+        denominator = (block_weights @ squared).clamp_min(1e-12)
+        assignments[start:end] = (numerator / denominator).argmax(dim=1)
+    return assignments
+
+
+def weighted_ls_radius(
+    positive: torch.Tensor,
+    selected: torch.Tensor,
+    weights: torch.Tensor,
+) -> torch.Tensor:
+    numerator = (weights * positive * selected).sum(dim=1)
+    denominator = (weights * selected.square()).sum(dim=1).clamp_min(1e-12)
+    return numerator / denominator
+
