@@ -0,0 +1,208 @@
+import pytest
+import torch
+from torch import nn
+
+from paroquant.optim.sagelinear import SAGEPseudoQuantizedLinear
+from paroquant.optim.sphlinear import (
+    SPHPseudoQuantizedLinear,
+    assign_directions,
+    assign_directions_weighted,
+    initialize_spherical_weight,
+    materialize_spherical_weight,
+    radius_fake_quantize,
+    spherical_kmeans,
+    weighted_ls_radius,
+)
+
+
+def test_radius_grid_rounds_offset_and_step_before_assigning_codes():
+    radii = (
+        torch.tensor(
+            [
+                0.10003,
+                0.1011,
+                0.104,
+                0.111,
+                0.13,
+                0.14,
+                0.16,
+                0.173,
+                0.182,
+                0.195,
+                0.212,
+                0.215,
+                0.22,
+                0.25,
+                0.275,
+                0.30017,
+            ]
+        )
+        .reshape(1, 16)
+        .requires_grad_(True)
+    )
+    for bits in (2, 3, 4):
+        offset = radii.detach().amin().half().float()
+        step = ((radii.detach().amax() - radii.detach().amin()) / ((1 << bits) - 1)).half().float()
+        codes = ((radii.detach() - offset) / step).round().clamp(0, (1 << bits) - 1)
+        expected = offset + step * codes
+        actual = radius_fake_quantize(radii, bits=bits)
+        torch.testing.assert_close(actual, expected, rtol=0, atol=0)
+        actual.sum().backward()
+        torch.testing.assert_close(radii.grad, torch.ones_like(radii))
+        radii.grad = None
+
+
+def test_constant_and_underflowed_radius_grids_use_fp16_offset():
+    radii = torch.full((2, 16), 0.10003)
+    radii[1] += torch.linspace(0, 1e-8, 16)
+    torch.testing.assert_close(
+        radius_fake_quantize(radii), radii.amin(1, keepdim=True).half().float().expand_as(radii)
+    )
+
+
+def test_weighted_assignment_matches_brute_force_and_uniform_rule():
+    torch.manual_seed(17)
+    positive = torch.rand(23, 8)
+    codebook = torch.rand(11, 8)
+    codebook /= codebook.norm(dim=1, keepdim=True)
+    weights = torch.rand_like(positive) + 0.01
+    numerator = (weights[:, None, :] * positive[:, None, :] * codebook[None, :, :]).sum(-1)
+    denominator = (weights[:, None, :] * codebook[None, :, :].square()).sum(-1)
+    radii = numerator / denominator
+    error = (
+        weights[:, None, :] * (positive[:, None, :] - radii[..., None] * codebook).square()
+    ).sum(-1)
+    indices = assign_directions_weighted(positive, codebook, weights, chunk_size=5)
+    assert torch.equal(indices, error.argmin(1))
+    torch.testing.assert_close(
+        weighted_ls_radius(positive, codebook[indices], weights), radii[torch.arange(23), indices]
+    )
+    assert torch.equal(
+        assign_directions_weighted(positive, codebook, torch.ones_like(weights)),
+        assign_directions(positive / positive.norm(dim=1, keepdim=True), codebook),
+    )
+
+
+@pytest.mark.parametrize("esg", [False, True])
+@pytest.mark.parametrize("adaptive_bits", [False, True])
+def test_sage_matches_candidate_scores_and_retains_winning_initialization(esg, adaptive_bits):
+    torch.manual_seed(5)
+    linear = nn.Linear(128, 16, bias=True)
+    energy = torch.logspace(-3, 3, 128)[torch.randperm(128)]
+    module = SAGEPseudoQuantizedLinear(
+        linear,
+        channel_energy=energy,
+        esg=esg,
+        adaptive_bits=adaptive_bits,
+        sample_size=256,
+        kmeans_iterations=2,
+        seed=19,
+    )
+    order = energy.argsort(descending=True).reshape(8, -1).T.flatten() if esg else torch.arange(128)
+    torch.testing.assert_close(module.channel_unpermutation, order.argsort())
+    weight = linear.weight.detach().float()[:, order]
+    weights = None
+    if esg:
+        weights = energy[order].reshape(-1, 8).pow(0.75)
+        weights = (weights / weights.mean(dim=1, keepdim=True)).repeat(16, 1)
+    errors = {}
+    states = {}
+    for bits in (6, 7, 8) if adaptive_bits else (6,):
+        state = initialize_spherical_weight(
+            weight,
+            sample_size=256,
+            kmeans_iterations=2,
+            codebook_bits=bits,
+            seed=19,
+            position_weights=weights,
+        )
+        reconstruction = materialize_spherical_weight(
+            **state, radius_bits=10 - bits, group_size=128
+        )
+        # Evaluate in original channel order, independently of the planner's layout.
+        reconstruction = reconstruction[:, order.argsort()]
+        errors[bits] = float(
+            ((linear.weight.detach() - reconstruction).square() * energy).sum()
+            / (linear.weight.detach().square() * energy).sum()
+        )
+        states[bits] = state
+    winner = min(errors, key=errors.get) if adaptive_bits else 6
+    assert module.radius_bits.item() == 10 - winner
+    if adaptive_bits:
+        assert module.candidate_errors == pytest.approx(errors, rel=1e-6)
+    else:
+        assert not module.candidate_errors
+    for key, value in states[winner].items():
+        torch.testing.assert_close(module.state_dict()[key], value, rtol=0, atol=0)
+    restored = SAGEPseudoQuantizedLinear.from_state_dict(module.state_dict())
+    torch.testing.assert_close(restored.pseudo_weight(), module.pseudo_weight(), rtol=0, atol=0)
+    torch.testing.assert_close(restored.bias, linear.bias)
+
+
+def test_disabling_esg_and_abs_recovers_sphquant_exactly():
+    torch.manual_seed(2)
+    linear = nn.Linear(128, 8, bias=False)
+    kwargs = dict(sample_size=128, kmeans_iterations=2, seed=3)
+    baseline = SPHPseudoQuantizedLinear(linear, **kwargs)
+    ablation = SAGEPseudoQuantizedLinear(linear, esg=False, adaptive_bits=False, **kwargs)
+    torch.testing.assert_close(ablation.pseudo_weight(), baseline.pseudo_weight(), rtol=0, atol=0)
+
+
+@pytest.mark.parametrize("checkpointing", [False, True])
+def test_sage_training_updates_only_radii_and_codebook(checkpointing):
+    torch.manual_seed(7)
+    module = SAGEPseudoQuantizedLinear(
+        nn.Linear(128, 16, bias=True),
+        channel_energy=torch.logspace(-2, 2, 128),
+        sample_size=256,
+        kmeans_iterations=1,
+    )
+    module.enable_checkpoint = checkpointing
+    module.set_optim_enabled(radius=True, codebook=True)
+    buffers = {name: value.clone() for name, value in module.named_buffers()}
+    parameters = {name: value.detach().clone() for name, value in module.named_parameters()}
+    optimizer = torch.optim.Adam([module.radius_logits, module.angle_logits], lr=0.001)
+    module(torch.randn(3, 128)).square().mean().backward()
+    assert module.radius_logits.grad.abs().sum() > 0
+    assert module.angle_logits.grad.abs().sum() > 0
+    optimizer.step()
+    for name, value in module.named_buffers():
+        torch.testing.assert_close(value, buffers[name], rtol=0, atol=0)
+    for name in ("radius_logits", "angle_logits"):
+        assert not torch.equal(module.get_parameter(name), parameters[name])
+    torch.testing.assert_close(module.bias, parameters["bias"], rtol=0, atol=0)
+
+
+def test_weighted_kmeans_centroid_update_matches_least_squares():
+    torch.manual_seed(11)
+    positive = torch.rand(13, 8)
+    weights = torch.rand(13, 8) + 0.01
+    radius = positive.norm(dim=1)
+    directions = positive / radius[:, None]
+    # Reproduce only the random draw, then derive the single-cluster update
+    # independently rather than invoking the implementation's assignment helpers.
+    generator = torch.Generator().manual_seed(23)
+    energy = (weights * positive.square()).sum(1)
+    sampled = torch.multinomial(energy / energy.sum(), 13, replacement=False, generator=generator)
+    center = directions[sampled[torch.randperm(13, generator=generator)[0]]]
+    radii = (weights * positive * center).sum(1) / (weights * center.square()).sum(1)
+    expected = (weights * radii[:, None] * positive).sum(0) / (
+        weights * radii[:, None].square()
+    ).sum(0)
+    expected /= expected.norm()
+    actual = spherical_kmeans(
+        directions,
+        radius,
+        sample_size=13,
+        iterations=1,
+        num_directions=1,
+        seed=23,
+        positive=positive,
+        position_weights=weights,
+    )
+    torch.testing.assert_close(actual[0], expected)
+
+
+def test_sage_requires_statistics_instead_of_silently_disabling_contributions():
+    with pytest.raises(ValueError, match="requires teacher input-channel energies"):
+        SAGEPseudoQuantizedLinear(nn.Linear(128, 16))
