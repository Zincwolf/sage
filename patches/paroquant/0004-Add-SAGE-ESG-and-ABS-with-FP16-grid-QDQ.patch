new file mode 100644
index 0000000..1eccdbe
--- /dev/null
+++ b/paroquant/optim/sagelinear.py
@@ -0,0 +1,102 @@
+"""SAGE: energy-stratified grouping and adaptive direction/radius bit splits."""
+
+from __future__ import annotations
+
+import torch
+from torch import nn
+
+from paroquant.optim.sphlinear import (
+    DEFAULT_CODEBOOK_BITS,
+    GROUP_SIZE,
+    INDEX_AND_RADIUS_BITS,
+    VECTOR_SIZE,
+    SPHPseudoQuantizedLinear,
+    initialize_spherical_weight,
+    materialize_spherical_weight,
+)
+
+SAGE_CODEBOOK_BITS = (6, 7, 8)
+
+
+class SAGEPseudoQuantizedLinear(SPHPseudoQuantizedLinear):
+    def __init__(
+        self,
+        linear: nn.Linear,
+        *,
+        channel_energy: torch.Tensor | None = None,
+        esg: bool = True,
+        adaptive_bits: bool = True,
+        energy_power: float = 0.75,
+        sample_size: int = 65536,
+        kmeans_iterations: int = 20,
+        codebook_bits: int = DEFAULT_CODEBOOK_BITS,
+        seed: int = 0,
+        initialized: dict[str, torch.Tensor] | None = None,
+    ) -> None:
+        # Only initialization needs calibration energies and candidate scores. The
+        # trained representation has the same spherical state plus a permutation.
+        candidate_errors: dict[int, float] = {}
+        if initialized is None:
+            if (esg or adaptive_bits) and channel_energy is None:
+                raise ValueError("SAGE ESG/ABS requires teacher input-channel energies")
+            with torch.no_grad():
+                weight = linear.weight.detach().float()
+                energy = (
+                    None if channel_energy is None else channel_energy.to(weight.device).float()
+                )
+                order = torch.arange(weight.shape[1], device=weight.device)
+                position_weights = None
+                if esg:
+                    # One channel from each of eight energy tiers per subvector.
+                    order = energy.argsort(descending=True).reshape(VECTOR_SIZE, -1).T.flatten()
+                    weight = weight[:, order]
+                    energy = energy[order]
+                    tempered = energy.reshape(-1, VECTOR_SIZE).pow(energy_power)
+                    mean = tempered.mean(dim=1, keepdim=True)
+                    position_weights = torch.where(
+                        mean > 0, tempered / mean.clamp_min(1e-12), torch.ones_like(tempered)
+                    ).repeat(weight.shape[0], 1)
+
+                # ABS scores with raw energy, not the tempered/normalized fit weights.
+                # Its candidates use the actual FP16-grid reconstruction, including
+                # angle/logit conversion. Retain the winner rather than refitting it.
+                candidates = SAGE_CODEBOOK_BITS if adaptive_bits else (codebook_bits,)
+                best_error = float("inf")
+                for bits in candidates:
+                    candidate = initialize_spherical_weight(
+                        weight,
+                        sample_size=sample_size,
+                        kmeans_iterations=kmeans_iterations,
+                        codebook_bits=bits,
+                        seed=seed,
+                        position_weights=position_weights,
+                    )
+                    if adaptive_bits:
+                        reconstructed = materialize_spherical_weight(
+                            **candidate,
+                            radius_bits=INDEX_AND_RADIUS_BITS - bits,
+                            group_size=GROUP_SIZE,
+                        )
+                        reference = (weight.square() * energy).sum()
+                        error = float(
+                            ((weight - reconstructed).square() * energy).sum()
+                            / reference.clamp_min(1e-30)
+                        )
+                        candidate_errors[bits] = error
+                        del reconstructed
+                    else:
+                        error = 0.0
+                    if initialized is None or error < best_error:
+                        best_error = error
+                        initialized = candidate
+                        codebook_bits = bits
+                initialized["channel_unpermutation"] = order.argsort()
+
+        super().__init__(linear, codebook_bits=codebook_bits, initialized=initialized)
+        self.register_buffer("channel_unpermutation", initialized["channel_unpermutation"])
+        self.register_buffer("sage_version", torch.tensor(1, dtype=torch.int32))
+        self.candidate_errors = candidate_errors
+
+    def materialized_weight(self) -> torch.Tensor:
+        # Dense QDQ absorbs ESG into the weights; no activation transform remains.
+        return super().materialized_weight()[:, self.channel_unpermutation]
