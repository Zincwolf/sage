 tests/test_sph_qwen3.py | 31 +++++++++++++++++++++++++++++++
 1 file changed, 31 insertions(+)

diff --git a/tests/test_sph_qwen3.py b/tests/test_sph_qwen3.py
index f8ef3ab..6a8a1f6 100644
--- a/tests/test_sph_qwen3.py
+++ b/tests/test_sph_qwen3.py
@@ -16,6 +16,37 @@ EXPECTED = {
 }
 
 
+def test_qwen3_vl_text_layer_has_exact_sph_projection_coverage():
+    from transformers import Qwen3VLTextConfig
+    from transformers.models.qwen3_vl.modeling_qwen3_vl import (
+        Qwen3VLTextDecoderLayer,
+    )
+
+    layer = Qwen3VLTextDecoderLayer(
+        Qwen3VLTextConfig(
+            vocab_size=64,
+            hidden_size=128,
+            intermediate_size=256,
+            num_hidden_layers=1,
+            num_attention_heads=4,
+            num_key_value_heads=2,
+            head_dim=32,
+        ),
+        layer_idx=0,
+    )
+    linears = get_named_linears(layer)
+    assert set(linears) == EXPECTED
+    for linear in linears.values():
+        sph = SPHPseudoQuantizedLinear(
+            linear,
+            sample_size=64,
+            kmeans_iterations=1,
+            seed=0,
+        )
+        assert sph.signs.shape == linear.weight.shape
+        assert torch.isfinite(sph.pseudo_weight()).all()
+
+
