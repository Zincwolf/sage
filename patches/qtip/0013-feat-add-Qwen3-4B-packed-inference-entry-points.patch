From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Zincwolf <zincwolf@outlook.com>
Date: Mon, 28 Sep 2026 21:23:24 +0800
Subject: [PATCH] feat: add Qwen3-4B packed inference entry points

---
 qtip-kernels/src/qtip_torch.cu | 46 ++++++++++++++++++++++++++++++++++
 qtip-kernels/src/wrapper.cpp   | 41 ++++++++++++++++++++++++++++++
 2 files changed, 87 insertions(+)

diff --git a/qtip-kernels/src/qtip_torch.cu b/qtip-kernels/src/qtip_torch.cu
index 9555ca9..4d20700 100644
--- a/qtip-kernels/src/qtip_torch.cu
+++ b/qtip-kernels/src/qtip_torch.cu
@@ -98,6 +98,52 @@ __host__ extern void decompress_matvec_16_9_4_1_3072_1_3072(
 
 
 
+// Qwen3-4B R=2 shapes; retain the upstream single-vector entry points.
+__host__ extern void decompress_matvec_16_9_2_1_1024_1_2560(
+        torch::Tensor &out,
+        torch::Tensor &compressed,
+        torch::Tensor &x,
+        torch::Tensor &codebook
+) {
+    decompress_matvec<16U, 9U, 2U, 1U, 1024U, 1U, 2560U>(out, compressed, x, codebook);
+}
+
+__host__ extern void decompress_matvec_16_9_2_1_4096_1_2560(
+        torch::Tensor &out,
+        torch::Tensor &compressed,
+        torch::Tensor &x,
+        torch::Tensor &codebook
+) {
+    decompress_matvec<16U, 9U, 2U, 1U, 4096U, 1U, 2560U>(out, compressed, x, codebook);
+}
+
+__host__ extern void decompress_matvec_16_9_2_1_9728_1_2560(
+        torch::Tensor &out,
+        torch::Tensor &compressed,
+        torch::Tensor &x,
+        torch::Tensor &codebook
+) {
+    decompress_matvec<16U, 9U, 2U, 1U, 9728U, 1U, 2560U>(out, compressed, x, codebook);
+}
+
+__host__ extern void decompress_matvec_16_9_2_1_2560_1_4096(
+        torch::Tensor &out,
+        torch::Tensor &compressed,
+        torch::Tensor &x,
+        torch::Tensor &codebook
+) {
+    decompress_matvec<16U, 9U, 2U, 1U, 2560U, 1U, 4096U>(out, compressed, x, codebook);
+}
+
+__host__ extern void decompress_matvec_16_9_2_1_2560_1_9728(
+        torch::Tensor &out,
+        torch::Tensor &compressed,
+        torch::Tensor &x,
+        torch::Tensor &codebook
+) {
+    decompress_matvec<16U, 9U, 2U, 1U, 2560U, 1U, 9728U>(out, compressed, x, codebook);
+}
+
 __host__ extern void decompress_matvec_16_9_2_1_53248_1_16384(
         torch::Tensor &out,
         torch::Tensor &compressed,
diff --git a/qtip-kernels/src/wrapper.cpp b/qtip-kernels/src/wrapper.cpp
index 9ab50cf..c112c47 100644
--- a/qtip-kernels/src/wrapper.cpp
+++ b/qtip-kernels/src/wrapper.cpp
@@ -36,6 +36,42 @@ void decompress_matvec_16_9_4_1_3072_1_3072(
 					  torch::Tensor &out
 					  );
 
+// Qwen3-4B R=2 shapes.
+void decompress_matvec_16_9_2_1_1024_1_2560(
+    torch::Tensor &out,
+    torch::Tensor &compressed,
+    torch::Tensor &x,
+    torch::Tensor &codebook
+);
+
+void decompress_matvec_16_9_2_1_4096_1_2560(
+    torch::Tensor &out,
+    torch::Tensor &compressed,
+    torch::Tensor &x,
+    torch::Tensor &codebook
+);
+
+void decompress_matvec_16_9_2_1_9728_1_2560(
+    torch::Tensor &out,
+    torch::Tensor &compressed,
+    torch::Tensor &x,
+    torch::Tensor &codebook
+);
+
+void decompress_matvec_16_9_2_1_2560_1_4096(
+    torch::Tensor &out,
+    torch::Tensor &compressed,
+    torch::Tensor &x,
+    torch::Tensor &codebook
+);
+
+void decompress_matvec_16_9_2_1_2560_1_9728(
+    torch::Tensor &out,
+    torch::Tensor &compressed,
+    torch::Tensor &x,
+    torch::Tensor &codebook
+);
+
 void decompress_matvec_16_9_2_1_53248_1_16384(
 					    torch::Tensor &compressed,
 					    torch::Tensor &codebook,
@@ -487,6 +523,11 @@ void decompress_matvec_16_9_4_1_1024_1_8192(
 
 
 PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {
+  m.def("decompress_matvec_16_9_2_1_1024_1_2560", &decompress_matvec_16_9_2_1_1024_1_2560, "decompress_matvec_16_9_2_1_1024_1_2560");
+  m.def("decompress_matvec_16_9_2_1_4096_1_2560", &decompress_matvec_16_9_2_1_4096_1_2560, "decompress_matvec_16_9_2_1_4096_1_2560");
+  m.def("decompress_matvec_16_9_2_1_9728_1_2560", &decompress_matvec_16_9_2_1_9728_1_2560, "decompress_matvec_16_9_2_1_9728_1_2560");
+  m.def("decompress_matvec_16_9_2_1_2560_1_4096", &decompress_matvec_16_9_2_1_2560_1_4096, "decompress_matvec_16_9_2_1_2560_1_4096");
+  m.def("decompress_matvec_16_9_2_1_2560_1_9728", &decompress_matvec_16_9_2_1_2560_1_9728, "decompress_matvec_16_9_2_1_2560_1_9728");
   m.def("decompress_matvec_16_9_2_1_256_1_256", &decompress_matvec_16_9_2_1_256_1_256, "decompress_matvec_16_9_2_1_256_1_256");
 
   m.def("decompress_matvec_16_9_4_1_1024_1_3072", &decompress_matvec_16_9_4_1_1024_1_3072, "decompress_matvec_16_9_4_1_1024_1_3072");
