diff --git a/lib/qwen3_vl/replay.py b/lib/qwen3_vl/replay.py
index 0670931..4019c28 100644
--- a/lib/qwen3_vl/replay.py
+++ b/lib/qwen3_vl/replay.py
@@ -8,8 +8,6 @@ from dataclasses import dataclass
 from pathlib import Path
 
 import torch
-from torch import nn
-
 from paroquant.optim.multimodal import (
     CocoCalibrationBatches,
     apply_deepstack_context,
@@ -19,6 +17,7 @@ from paroquant.optim.util import (
     capture_layer_inputs_and_args,
     to_device,
 )
+from torch import nn
 
 from .hessian import LayerHessianCollectors
 
@@ -101,7 +100,7 @@ def capture_split(
             f"{len(first_layer_inputs)} vs {len(recorder.valid_masks)}"
         )
     for index, (hidden, mask) in enumerate(
-        zip(first_layer_inputs, recorder.valid_masks)
+        zip(first_layer_inputs, recorder.valid_masks, strict=True)
     ):
         if tuple(hidden.shape[:2]) != tuple(mask.shape):
             raise RuntimeError(
@@ -221,6 +220,7 @@ def apply_post_layer_context(
         for output, context in zip(
             outputs,
             captured.deepstack_contexts,
+            strict=True,
         )
     ]
 
@@ -277,6 +277,7 @@ def build_reconstruction_batches(
             captured.kwargs_by_layer[layer_index],
             retained_source,
             captured.valid_masks,
+            strict=True,
         )
     ]
 
