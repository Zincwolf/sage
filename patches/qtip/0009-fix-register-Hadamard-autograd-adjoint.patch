Subject: [PATCH] fix: register Hadamard autograd adjoint

---
 lib/utils/matmul_had.py         | 14 ++++++++++++++
 tests/test_hadamard_autograd.py | 33 +++++++++++++++++++++++++++++++++
 2 files changed, 47 insertions(+)
 create mode 100644 tests/test_hadamard_autograd.py

diff --git a/lib/utils/matmul_had.py b/lib/utils/matmul_had.py
index 9b4f59b..4161fd2 100644
--- a/lib/utils/matmul_had.py
+++ b/lib/utils/matmul_had.py
@@ -128,6 +128,20 @@ def hadamard(x: torch.Tensor, scale: float) -> torch.Tensor:
     return output * scale
 
 
+def _hadamard_setup_context(ctx, inputs, output):
+    ctx.scale = inputs[1]
+
+
+def _hadamard_backward(ctx, grad_output):
+    # Sylvester Hadamard is symmetric; its adjoint has the same scale.
+    return torch.ops.hadamard.hadamard(grad_output.contiguous(), ctx.scale), None
+
+
+torch.library.register_autograd(
+    "hadamard::hadamard", _hadamard_backward,
+    setup_context=_hadamard_setup_context)
+
+
 def matmul_hadU_cuda(X, hadK, K, transpose=False):
     n = X.shape[-1]
     if K < 0:
diff --git a/tests/test_hadamard_autograd.py b/tests/test_hadamard_autograd.py
new file mode 100644
index 0000000..8cc5eb9
--- /dev/null
+++ b/tests/test_hadamard_autograd.py
@@ -0,0 +1,33 @@
+import warnings
+
+import pytest
+import torch
+
+from lib.utils.matmul_had import get_hadK, matmul_hadU_cuda
+
+
+def test_registered_hadamard_gradcheck():
+    value = torch.randn(2, 8, dtype=torch.float64, requires_grad=True)
+    assert torch.autograd.gradcheck(
+        lambda x: torch.ops.hadamard.hadamard(x, 8 ** -0.5), (value,))
+
+
+@pytest.mark.parametrize('width', [128, 2560, 9728])
+@pytest.mark.parametrize('device', ['cpu', 'cuda'])
+def test_hadamard_gradient_is_orthogonal_adjoint(width, device):
+    if device == 'cuda' and not torch.cuda.is_available():
+        pytest.skip('CUDA is unavailable')
+    torch.manual_seed(5)
+    value = torch.randn(2, width, device=device, requires_grad=True)
+    # Noncontiguous gradient also exercises the custom backward boundary.
+    gradient = torch.randn(width, 2, device=device).T
+    had, k = get_hadK(width)
+    with warnings.catch_warnings(record=True) as caught:
+        result = matmul_hadU_cuda(value, had, k)
+        result.backward(gradient)
+    assert not any('autograd kernel was not registered' in str(w.message) for w in caught)
+    expected = matmul_hadU_cuda(gradient, had, k, transpose=True)
+    torch.testing.assert_close(value.grad, expected, atol=2e-6, rtol=2e-5)
+    torch.testing.assert_close(
+        matmul_hadU_cuda(result.detach(), had, k, transpose=True),
+        value.detach(), atol=2e-6, rtol=2e-5)
