diff --git a/lib/qwen3_vl/hessian.py b/lib/qwen3_vl/hessian.py
new file mode 100644
index 0000000..516755f
--- /dev/null
+++ b/lib/qwen3_vl/hessian.py
@@ -0,0 +1,119 @@
+"""Padding-aware QTIP Hessian collection for Qwen3-VL."""
+
+from __future__ import annotations
+
+import torch
+from torch import nn
+
+
+class MaskedHessianCollector:
+    """Accumulate E[x x.T] over valid sequence positions."""
+
+    def __init__(
+        self,
+        module: nn.Linear,
+        *,
+        include_padding: bool = False,
+    ) -> None:
+        self.size = module.in_features
+        self.include_padding = include_padding
+        self.matrix = torch.zeros(
+            self.size,
+            self.size,
+            dtype=torch.float32,
+            device=module.weight.device,
+        )
+        self.count = 0
+        self._position_mask: torch.Tensor | None = None
+        self._handle = module.register_forward_pre_hook(self._hook)
+
+    def set_position_mask(self, mask: torch.Tensor) -> None:
+        if mask.ndim != 2:
+            raise ValueError(
+                f"Expected a [batch, sequence] mask, got {tuple(mask.shape)}"
+            )
+        self._position_mask = mask.detach().to(
+            device=self.matrix.device,
+            dtype=torch.bool,
+        )
+
+    @torch.no_grad()
+    def _hook(self, _module: nn.Module, inputs: tuple[torch.Tensor, ...]) -> None:
+        values = inputs[0]
+        if values.shape[-1] != self.size:
+            raise RuntimeError(
+                f"Projection input width {values.shape[-1]} != {self.size}"
+            )
+        flattened = values.reshape(-1, self.size).float()
+        if not self.include_padding:
+            if self._position_mask is None:
+                raise RuntimeError(
+                    "Position mask must be set before every layer forward"
+                )
+            flat_mask = self._position_mask.reshape(-1)
+            if flat_mask.numel() != flattened.shape[0]:
+                raise RuntimeError(
+                    "Projection input and position mask are misaligned: "
+                    f"{flattened.shape[0]} rows vs {flat_mask.numel()} mask "
+                    "entries"
+                )
+            flattened = flattened[flat_mask]
+        if flattened.numel() == 0:
+            return
+        self.matrix.addmm_(flattened.T, flattened)
+        self.count += flattened.shape[0]
+
+    def close(self) -> dict[str, torch.Tensor | int | str]:
+        self._handle.remove()
+        if self.count == 0:
+            raise RuntimeError("Hessian collector observed no valid inputs")
+        matrix = (self.matrix / self.count).cpu()
+        rows, columns = torch.tril_indices(self.size, self.size)
+        flattened = matrix[rows, columns].contiguous()
+        self.matrix = torch.empty(0)
+        result = {
+            "flatH": flattened,
+            "n": self.size,
+            "ct": self.count,
+            "position_mask": (
+                "all" if self.include_padding else "attention_mask"
+            ),
+        }
+        return result
+
+
+def collector_modules(layer: nn.Module) -> dict[str, nn.Linear]:
+    return {
+        "qkv": layer.self_attn.q_proj,
+        "o": layer.self_attn.o_proj,
+        "up": layer.mlp.up_proj,
+        "down": layer.mlp.down_proj,
+    }
+
+
+class LayerHessianCollectors:
+    def __init__(
+        self,
+        layer: nn.Module,
+        *,
+        include_padding: bool = False,
+    ) -> None:
+        self.collectors = {
+            name: MaskedHessianCollector(
+                module,
+                include_padding=include_padding,
+            )
+            for name, module in collector_modules(layer).items()
+        }
+
+    def set_position_mask(self, mask: torch.Tensor) -> None:
+        for collector in self.collectors.values():
+            collector.set_position_mask(mask)
+
+    def close(
+        self,
+    ) -> dict[str, dict[str, torch.Tensor | int | str]]:
+        return {
+            name: collector.close()
+            for name, collector in self.collectors.items()
+        }
diff --git a/tests/test_qwen3_vl_hessian.py b/tests/test_qwen3_vl_hessian.py
new file mode 100644
index 0000000..8fd31f2
--- /dev/null
+++ b/tests/test_qwen3_vl_hessian.py
@@ -0,0 +1,99 @@
+import torch
+from torch import nn
+
+from lib.qwen3_vl.hessian import (
+    LayerHessianCollectors,
+    MaskedHessianCollector,
+    collector_modules,
+)
+
+
+class TinyAttention(nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.q_proj = nn.Linear(2, 2, bias=False)
+        self.k_proj = nn.Linear(2, 2, bias=False)
+        self.v_proj = nn.Linear(2, 2, bias=False)
+        self.o_proj = nn.Linear(2, 2, bias=False)
+
+
+class TinyMlp(nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.gate_proj = nn.Linear(2, 2, bias=False)
+        self.up_proj = nn.Linear(2, 2, bias=False)
+        self.down_proj = nn.Linear(2, 2, bias=False)
+
+
+class TinyLayer(nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.self_attn = TinyAttention()
+        self.mlp = TinyMlp()
+
+    def forward(self, hidden_states):
+        attention = self.self_attn.q_proj(hidden_states)
+        attention = self.self_attn.o_proj(attention)
+        mlp = self.mlp.up_proj(hidden_states)
+        return self.mlp.down_proj(mlp) + attention
+
+
+def test_masked_hessian_excludes_padding_rows():
+    linear = nn.Linear(2, 2, bias=False)
+    collector = MaskedHessianCollector(linear)
+    values = torch.tensor(
+        [[[1.0, 2.0], [100.0, 100.0], [3.0, 4.0]]]
+    )
+    collector.set_position_mask(torch.tensor([[True, False, True]]))
+    linear(values)
+    result = collector.close()
+
+    selected = values[:, [0, 2], :].reshape(-1, 2)
+    expected = selected.T @ selected / selected.shape[0]
+    rows, columns = torch.tril_indices(2, 2)
+    torch.testing.assert_close(
+        result["flatH"],
+        expected[rows, columns],
+    )
+    assert result["n"] == 2
+    assert result["ct"] == 2
+    assert result["position_mask"] == "attention_mask"
+
+
+def test_unmasked_hessian_counts_every_position():
+    linear = nn.Linear(2, 2, bias=False)
+    collector = MaskedHessianCollector(linear, include_padding=True)
+    collector.set_position_mask(torch.tensor([[True, False, True]]))
+    collector_values = torch.randn(1, 3, 2)
+    linear(collector_values)
+    result = collector.close()
+
+    assert result["ct"] == 3
+    assert result["position_mask"] == "all"
+
+
+def test_layer_collectors_use_qtip_hessian_groups():
+    layer = TinyLayer()
+    assert set(collector_modules(layer)) == {"qkv", "o", "up", "down"}
+
+    collectors = LayerHessianCollectors(layer)
+    collectors.set_position_mask(torch.tensor([[True, False, True]]))
+    layer(torch.randn(1, 3, 2))
+    result = collectors.close()
+
+    assert set(result) == {"qkv", "o", "up", "down"}
+    assert all(payload["ct"] == 2 for payload in result.values())
+    assert all(payload["flatH"].shape == (3,) for payload in result.values())
+
+
+def test_mask_is_required_before_projection_forward():
+    linear = nn.Linear(2, 2, bias=False)
+    collector = MaskedHessianCollector(linear)
+    try:
+        linear(torch.randn(1, 2, 2))
+    except RuntimeError as error:
+        assert "Position mask must be set" in str(error)
+    else:
+        raise AssertionError("Expected missing mask rejection")
+    finally:
+        collector._handle.remove()
