diff --git a/tests/test_dense_only.py b/tests/test_dense_only.py
index b125967..75cbe80 100644
--- a/tests/test_dense_only.py
+++ b/tests/test_dense_only.py
@@ -186,3 +186,143 @@ def test_quantize_recovers_transformed_hessian_without_tp_reshape(
     assert checkpoint["transformed_hessian_jitter"] == 1e-2
     assert checkpoint["rcp"] == 0
     assert kernel_modes == [False]
+
+
+def test_projection_resume_matches_uninterrupted_quantization(monkeypatch, tmp_path):
+    from lib.algo import finetune
+
+    class Layer(torch.nn.Module):
+        def __init__(self):
+            super().__init__()
+            self.block = torch.nn.Module()
+            self.block.first = torch.nn.Linear(4, 4, bias=False)
+            self.block.second = torch.nn.Linear(4, 4, bias=False)
+
+    class Codebook:
+        lut = torch.ones(2)
+
+        def to(self, *_args):
+            return self
+
+        def cpu(self):
+            return self
+
+        def pack_trellis(self, trellis):
+            return trellis[:, :1].to(torch.int16)
+
+    lower = torch.tril_indices(4, 4)
+    hessian = torch.eye(4)
+    for name in ("first", "second"):
+        torch.save(
+            {"flatH": hessian[lower[0], lower[1]], "n": 4},
+            tmp_path / f"0_{name}.pt",
+        )
+    monkeypatch.setattr(finetune.utils, "matmul_hadUt", lambda value: value)
+    monkeypatch.setattr(finetune.utils, "has_kernel", lambda *_args: False)
+    monkeypatch.setattr(
+        finetune.ldlq,
+        "LDLQ",
+        lambda weight, _factor, _codebook, _args, **_kwargs: (
+            weight.clone(),
+            torch.zeros((4, 2), dtype=torch.int64),
+        ),
+    )
+    args = SimpleNamespace(
+        seed=23,
+        num_cpu_threads=torch.get_num_threads(),
+        use_fp64=False,
+        reconstruction_epochs=1,
+        gradient_checkpointing=False,
+        train_lut=False,
+        decode_mode="quantlut_sym",
+        L=4,
+        K=1,
+        V=2,
+        tlut_bits=3,
+        td_x=2,
+        td_y=2,
+        packed_inference_kernel=False,
+        split_for_tp=False,
+        tp_rank=8,
+        hessians=tmp_path,
+        checkpoints=tmp_path / "full",
+        sigma_reg=1e-2,
+        scale_override=1.0,
+    )
+    args.checkpoints.mkdir()
+    quant_order = (
+        ("block.first", "first", "first", "unused", "row"),
+        ("block.second", "second", "second", "unused", "row"),
+    )
+    initial = Layer().state_dict()
+    interrupted_state = None
+
+    def interrupt(completed, projections):
+        nonlocal interrupted_state
+        interrupted_state = {"completed": completed, "projections": projections}
+        raise InterruptedError
+
+    def reconstruct(layer, _name, _dtype):
+        with torch.no_grad():
+            for module in layer.modules():
+                if hasattr(module, "SU"):
+                    module.SU.add_(0.25)
+                    module.SV.add_(0.5)
+
+    grad_enabled = torch.is_grad_enabled()
+    try:
+        full = Layer()
+        full.load_state_dict(initial)
+        finetune.quantize_finetune_decoder_layer(
+            full,
+            quant_order,
+            0,
+            Codebook(),
+            args,
+            torch.device("cpu"),
+            None,
+            None,
+            reconstruction_callback=reconstruct,
+        )
+
+        interrupted = Layer()
+        interrupted.load_state_dict(initial)
+        with pytest.raises(InterruptedError):
+            finetune.quantize_finetune_decoder_layer(
+                interrupted,
+                quant_order,
+                0,
+                Codebook(),
+                args,
+                torch.device("cpu"),
+                None,
+                None,
+                progress_callback=interrupt,
+                reconstruction_callback=reconstruct,
+                write_checkpoints=False,
+            )
+
+        args.checkpoints = tmp_path / "resumed"
+        args.checkpoints.mkdir()
+        resumed = Layer()
+        resumed.load_state_dict(initial)
+        finetune.quantize_finetune_decoder_layer(
+            resumed,
+            quant_order,
+            0,
+            Codebook(),
+            args,
+            torch.device("cpu"),
+            None,
+            None,
+            resume_state=interrupted_state,
+            reconstruction_callback=reconstruct,
+        )
+    finally:
+        torch.set_grad_enabled(grad_enabled)
+
+    for name in ("first", "second"):
+        full_payload = torch.load(tmp_path / "full" / f"0_{name}.pt", weights_only=True)
+        resumed_payload = torch.load(tmp_path / "resumed" / f"0_{name}.pt", weights_only=True)
+        for key in ("trellis", "SU", "SV", "Wscale"):
+            torch.testing.assert_close(resumed_payload[key], full_payload[key])
