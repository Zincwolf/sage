diff --git a/lib/algo/finetune.py b/lib/algo/finetune.py
index 0c60183..bf9ee85 100644
--- a/lib/algo/finetune.py
+++ b/lib/algo/finetune.py
@@ -130,7 +130,7 @@ def finetune_decoder_layer(layer, name, device, train_dl, valid_dl, orig_dtype,
 def quantize_finetune_decoder_layer(mixed_layer, quant_order, idx, cb, args,
                                     device, pre_orig_emb, orig_emb,
                                     reconstruction_adapter=None):
-    torch.manual_seed(idx)
+    torch.manual_seed(getattr(args, 'seed', 0) + idx)
     torch.set_num_threads(args.num_cpu_threads)
     torch.set_grad_enabled(False)
 
@@ -150,8 +150,9 @@ def quantize_finetune_decoder_layer(mixed_layer, quant_order, idx, cb, args,
     else:
         train_dl = valid_dl = None
 
-    has_kernel = utils.has_kernel(args.decode_mode, args.L, args.K, args.V,
-                                  args.tlut_bits, args.td_x, args.td_y)
+    has_kernel = (not getattr(args, 'disable_kernel', False)
+                  and utils.has_kernel(args.decode_mode, args.L, args.K, args.V,
+                                       args.tlut_bits, args.td_x, args.td_y))
 
     for quant_i, (linear_attr, name, in_hess_name, out_hess_name,
                   rcp) in enumerate(quant_order):
@@ -229,7 +230,22 @@ def quantize_finetune_decoder_layer(mixed_layer, quant_order, idx, cb, args,
                 args.scale_override)
             Wr /= Wscale
 
-        LRr, _ = utils.block_LDL(HRr, args.td_y)
+        transformed_hessian_jitter = 0.0
+        block_ldl = utils.block_LDL(HRr, args.td_y)
+        if block_ldl is None:
+            # A high-dynamic-range PSD Hessian can lose positive definiteness
+            # through cancellation in the FP32 randomized Hadamard transform.
+            # Restore symmetry and regularize again in transformed coordinates.
+            utils.clean()
+            HRr = (HRr + HRr.T) * 0.5
+            transformed_hessian_jitter = args.sigma_reg
+            HRr.diagonal().add_(
+                HRr.diagonal().mean() * transformed_hessian_jitter)
+            block_ldl = utils.block_LDL(HRr.contiguous(), args.td_y)
+        if block_ldl is None:
+            raise RuntimeError(
+                f'block LDL failed for layer {idx} projection {name}')
+        LRr, _ = block_ldl
         diag = torch.arange(n, device=LRr.device)
         LRr[diag, diag] = 0
 
@@ -250,12 +266,12 @@ def quantize_finetune_decoder_layer(mixed_layer, quant_order, idx, cb, args,
         else:
             packed = packed.view(torch.int16)
 
-        if rcp == 'col':
+        if args.split_for_tp and rcp == 'col':
             Wr = (Wr.reshape(args.tp_rank, m * n // args.tp_rank) *
                   Wscale.unsqueeze(-1)).reshape(m, n)
             hatWr = (hatWr.reshape(args.tp_rank, m * n // args.tp_rank) *
                      Wscale.unsqueeze(-1)).reshape(m, n)
-        elif rcp == 'row':
+        elif args.split_for_tp and rcp == 'row':
             Wr = Wr.reshape(m, args.tp_rank, n // args.tp_rank).transpose(
                 0, 1).reshape(args.tp_rank, -1) * Wscale.unsqueeze(-1)
             Wr = Wr.reshape(args.tp_rank, m,
@@ -289,6 +305,7 @@ def quantize_finetune_decoder_layer(mixed_layer, quant_order, idx, cb, args,
             'SV': SV.to(orig_dtype).cpu(),
             'Wscale': Wscale,
             'proxy_err': err.item(),
+            'transformed_hessian_jitter': transformed_hessian_jitter,
             'tlut': (
                 cb.tlut.data.to(orig_dtype).cpu()
                 if hasattr(cb, 'tlut') else None
@@ -331,13 +348,13 @@ def quantize_finetune_decoder_layer(mixed_layer, quant_order, idx, cb, args,
         del packed, SU, SV
         utils.clean()
         
-        if rcp == 'row':
+        if args.split_for_tp and rcp == 'row':
             q_linear.SU = nn.Parameter(
                 (q_linear.SU.reshape(args.tp_rank, -1) *
                  Wscale.unsqueeze(-1)).reshape(q_linear.SU.shape),
                 requires_grad=True)
             q_linear.SV = nn.Parameter(q_linear.SV, requires_grad=True)
-        elif rcp == 'col':
+        elif args.split_for_tp and rcp == 'col':
             q_linear.SU = nn.Parameter(q_linear.SU, requires_grad=True)
             q_linear.SV = nn.Parameter(
                 (q_linear.SV.reshape(args.tp_rank, -1) *
@@ -383,13 +400,13 @@ def quantize_finetune_decoder_layer(mixed_layer, quant_order, idx, cb, args,
         quant_linear = attrgetter(linear_attr)(mixed_layer)
         save_path = f'{args.save_path}/{idx}_{name}.pt'
         data = torch.load(save_path, weights_only=True)
-        if rcp == 'row':
+        if args.split_for_tp and rcp == 'row':
             data['SU'] = (
                 ((quant_linear.SU.data).reshape(args.tp_rank, -1) /
                  data['Wscale'].to(quant_linear.SU.device).unsqueeze(-1)
                  ).reshape(quant_linear.SU.data.shape)).to(orig_dtype).cpu()
             data['SV'] = quant_linear.SV.data.to(orig_dtype).cpu()
-        elif rcp == 'col':
+        elif args.split_for_tp and rcp == 'col':
             data['SU'] = quant_linear.SU.data.to(orig_dtype).cpu()
             data['SV'] = (
                 ((quant_linear.SV.data).reshape(args.tp_rank, -1) /
diff --git a/tests/test_dense_only.py b/tests/test_dense_only.py
index 02b8685..a34d787 100644
--- a/tests/test_dense_only.py
+++ b/tests/test_dense_only.py
@@ -1,3 +1,5 @@
+from types import SimpleNamespace
+
 import pytest
 import torch
 
@@ -60,8 +62,6 @@ def test_dense_trellis_roundtrip_without_packed_cuda_kernels():
 
 
 def test_ldlq_runs_without_packed_cuda_kernels():
-    from types import SimpleNamespace
-
     from lib.algo.ldlq import LDLQ
     from lib.codebook.bitshift import bitshift_codebook
 
@@ -87,3 +87,80 @@ def test_ldlq_runs_without_packed_cuda_kernels():
     assert reconstructed.shape == weight.shape
     assert trellis.shape == (4, 2)
     assert torch.isfinite(reconstructed).all()
+
+
+@pytest.mark.parametrize("rcp", ["row", "col"])
+def test_quantize_recovers_transformed_hessian_without_tp_reshape(
+    monkeypatch, tmp_path, rcp
+):
+    from lib.algo import finetune
+
+    class Layer(torch.nn.Module):
+        def __init__(self):
+            super().__init__()
+            self.proj = torch.nn.Linear(4, 6, bias=False)
+
+    class Codebook:
+        lut = torch.ones(2)
+
+        def to(self, *_args):
+            return self
+
+        def cpu(self):
+            return self
+
+        def pack_trellis(self, trellis):
+            return trellis.to(torch.int16)
+
+    hessian = torch.eye(4)
+    hessian[0, 1] = hessian[1, 0] = 1.005
+    lower = torch.tril_indices(4, 4)
+    torch.save({"flatH": hessian[lower[0], lower[1]], "n": 4}, tmp_path / "3_h.pt")
+
+    kernel_modes = []
+    monkeypatch.setattr(finetune.utils, "regularize_H", lambda value, _sigma: value)
+    monkeypatch.setattr(finetune.utils, "matmul_hadUt", lambda value: value)
+    monkeypatch.setattr(finetune.utils, "has_kernel", lambda *_args: True)
+
+    def fake_ldlq(weight, _factor, _codebook, _args, *, for_kernel):
+        kernel_modes.append(for_kernel)
+        return weight.clone(), torch.zeros((6, 2), dtype=torch.int64)
+
+    monkeypatch.setattr(finetune.ldlq, "LDLQ", fake_ldlq)
+    args = SimpleNamespace(
+        seed=11,
+        num_cpu_threads=torch.get_num_threads(),
+        use_fp64=False,
+        ft_epochs=0,
+        decode_mode="quantlut_sym",
+        L=4,
+        K=1,
+        V=2,
+        tlut_bits=3,
+        td_x=2,
+        td_y=2,
+        disable_kernel=True,
+        split_for_tp=False,
+        tp_rank=8,
+        in_hess_path=tmp_path,
+        save_path=tmp_path,
+        sigma_reg=1e-2,
+        scale_override=1.0,
+    )
+
+    grad_enabled = torch.is_grad_enabled()
+    try:
+        finetune.quantize_finetune_decoder_layer(
+            Layer(), (("proj", "proj", "h", "unused", rcp),), 3,
+            Codebook(), args, torch.device("cpu"), None, None,
+        )
+    finally:
+        torch.set_grad_enabled(grad_enabled)
+
+    checkpoint = torch.load(tmp_path / "3_proj.pt", weights_only=True)
+    generator = torch.Generator().manual_seed(14)
+    expected_su = (torch.randn(4, generator=generator).sign() + 1e-5).sign()
+    assert torch.equal(checkpoint["SU"], expected_su)
+    assert checkpoint["transformed_hessian_jitter"] == 1e-2
+    assert checkpoint["rcp"] == 0
+    assert kernel_modes == [False]
