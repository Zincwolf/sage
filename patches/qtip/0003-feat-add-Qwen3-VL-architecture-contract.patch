index 0000000..f20949d
--- /dev/null
+++ b/lib/qwen3_vl/common.py
@@ -0,0 +1,192 @@
+"""Qwen3-VL architecture and checkpoint contracts for QTIP."""
+
+from __future__ import annotations
+
+from operator import attrgetter
+from pathlib import Path
+
+from torch import nn
+
+EXPECTED_LAYERS = 36
+PROJECTIONS = (
+    ("self_attn.v_proj", "v", "qkv", "col"),
+    ("self_attn.q_proj", "q", "qkv", "col"),
+    ("self_attn.k_proj", "k", "qkv", "col"),
+    ("self_attn.o_proj", "o", "o", "row"),
+    ("mlp.up_proj", "up", "up", "col"),
+    ("mlp.gate_proj", "gate", "up", "col"),
+    ("mlp.down_proj", "down", "down", "row"),
+)
+HESSIAN_NAMES = ("qkv", "o", "up", "down")
+
+
+def quant_order() -> list[tuple[str, str, str, str, str]]:
+    return [
+        (attribute, short, hessian, short, parallel)
+        for attribute, short, hessian, parallel in PROJECTIONS
+    ]
+
+
+def projection_paths(
+    layer_index: int,
+    checkpoint_dir: str | Path,
+) -> tuple[Path, ...]:
+    checkpoint_dir = Path(checkpoint_dir)
+    return tuple(
+        checkpoint_dir / f"{layer_index}_{short}.pt"
+        for _, short, _, _ in PROJECTIONS
+    )
+
+
+def layer_complete(
+    layer_index: int,
+    checkpoint_dir: str | Path,
+) -> bool:
+    checkpoint_dir = Path(checkpoint_dir)
+    marker = checkpoint_dir / f"{layer_index}.complete"
+    return marker.is_file() and all(
+        path.is_file()
+        for path in projection_paths(layer_index, checkpoint_dir)
+    )
+
+
+def hessian_complete(
+    layer_index: int,
+    hessian_dir: str | Path,
+) -> bool:
+    hessian_dir = Path(hessian_dir)
+    return all(
+        (hessian_dir / f"{layer_index}_{name}.pt").is_file()
+        for name in HESSIAN_NAMES
+    )
+
+
+def get_language_model(model: nn.Module) -> nn.Module:
+    inner = getattr(model, "model", None)
+    language_model = getattr(inner, "language_model", None)
+    if language_model is None:
+        language_model = getattr(model, "language_model", None)
+    if language_model is None:
+        raise TypeError(
+            f"{type(model).__name__} does not expose a Qwen3-VL "
+            "language model"
+        )
+    return language_model
+
+
+def get_layers(model: nn.Module) -> nn.ModuleList:
+    layers = getattr(get_language_model(model), "layers", None)
+    if not isinstance(layers, nn.ModuleList):
+        raise TypeError("Qwen3-VL language_model.layers is not a ModuleList")
+    return layers
+
+
+def _config_value(config, name: str, default=None):
+    if isinstance(config, dict):
+        return config.get(name, default)
+    return getattr(config, name, default)
+
+
+def audit_qwen3_vl(
+    model: nn.Module,
+    *,
+    expected_layers: int = EXPECTED_LAYERS,
+    tile_rows: int = 16,
+    tile_columns: int = 16,
+) -> dict:
+    config = model.config
+    model_type = _config_value(config, "model_type")
+    if model_type != "qwen3_vl":
+        raise RuntimeError(
+            f"Expected model_type=qwen3_vl, got {model_type!r}"
+        )
+
+    layers = get_layers(model)
+    if len(layers) != expected_layers:
+        raise RuntimeError(
+            f"Expected {expected_layers} decoder layers, found {len(layers)}"
+        )
+
+    text_config = _config_value(config, "text_config")
+    configured_layers = _config_value(text_config, "num_hidden_layers")
+    if configured_layers is not None and int(configured_layers) != len(layers):
+        raise RuntimeError(
+            "text_config.num_hidden_layers does not match language backbone: "
+            f"{configured_layers} vs {len(layers)}"
+        )
+
+    projection_shapes = {}
+    for index, layer in enumerate(layers):
+        for attribute, _, _, _ in PROJECTIONS:
+            try:
+                module = attrgetter(attribute)(layer)
+            except AttributeError as error:
+                raise AttributeError(
+                    f"layer {index} is missing QTIP projection {attribute}"
+                ) from error
+            if not isinstance(module, nn.Linear):
+                raise TypeError(
+                    f"layer {index} {attribute} is "
+                    f"{type(module).__name__}, not nn.Linear"
+                )
+            if module.out_features % tile_rows:
+                raise ValueError(
+                    f"layer {index} {attribute} output width "
+                    f"{module.out_features} is not divisible by QTIP "
+                    f"tile rows {tile_rows}"
+                )
+            if module.in_features % tile_columns:
+                raise ValueError(
+                    f"layer {index} {attribute} input width "
+                    f"{module.in_features} is not divisible by QTIP "
+                    f"tile columns {tile_columns}"
+                )
+            projection_shapes.setdefault(
+                attribute,
+                [module.out_features, module.in_features],
+            )
+
+    vision_config = _config_value(config, "vision_config")
+    deepstack_indexes = _config_value(
+        vision_config,
+        "deepstack_visual_indexes",
+        [],
+    )
+    if not deepstack_indexes:
+        raise RuntimeError(
+            "Qwen3-VL vision_config has no deepstack_visual_indexes"
+        )
+
+    return {
+        "model_type": model_type,
+        "num_hidden_layers": len(layers),
+        "projection_count": len(layers) * len(PROJECTIONS),
+        "projections_per_layer": len(PROJECTIONS),
+        "projection_shapes": projection_shapes,
+        "deepstack_visual_indexes": list(deepstack_indexes),
+        "deepstack_language_injection_layers": list(
+            range(len(deepstack_indexes))
+        ),
+    }
+
+
+def projection_state_key(layer_index: int, projection: str) -> str:
+    return (
+        f"model.language_model.layers.{layer_index}."
+        f"{projection}.weight"
+    )
+
+
+__all__ = [
+    "EXPECTED_LAYERS",
+    "HESSIAN_NAMES",
+    "PROJECTIONS",
+    "audit_qwen3_vl",
+    "get_language_model",
+    "get_layers",
+    "hessian_complete",
+    "layer_complete",
+    "projection_paths",
+    "projection_state_key",
+    "quant_order",
+]
diff --git a/tests/test_qwen3_vl_common.py b/tests/test_qwen3_vl_common.py
new file mode 100644
index 0000000..64a3782
--- /dev/null
+++ b/tests/test_qwen3_vl_common.py
@@ -0,0 +1,168 @@
+from pathlib import Path
+from types import SimpleNamespace
+
+import torch
+from torch import nn
+
+from lib.qwen3_vl.common import (
+    HESSIAN_NAMES,
+    PROJECTIONS,
+    audit_qwen3_vl,
+    get_layers,
+    hessian_complete,
+    layer_complete,
+    projection_paths,
+    projection_state_key,
+    quant_order,
+)
+
+
+class TinyAttention(nn.Module):
+    def __init__(self, width=16):
+        super().__init__()
+        self.q_proj = nn.Linear(width, width, bias=False)
+        self.k_proj = nn.Linear(width, width, bias=False)
+        self.v_proj = nn.Linear(width, width, bias=False)
+        self.o_proj = nn.Linear(width, width, bias=False)
+
+
+class TinyMlp(nn.Module):
+    def __init__(self, width=16):
+        super().__init__()
+        self.gate_proj = nn.Linear(width, width, bias=False)
+        self.up_proj = nn.Linear(width, width, bias=False)
+        self.down_proj = nn.Linear(width, width, bias=False)
+
+
+class TinyLayer(nn.Module):
+    def __init__(self, width=16):
+        super().__init__()
+        self.self_attn = TinyAttention(width)
+        self.mlp = TinyMlp(width)
+
+
+class TinyLanguageModel(nn.Module):
+    def __init__(self, layer_count):
+        super().__init__()
+        self.layers = nn.ModuleList(
+            TinyLayer() for _ in range(layer_count)
+        )
+
+
+class TinyQwen3VL(nn.Module):
+    def __init__(self, layer_count):
+        super().__init__()
+        self.model = nn.Module()
+        self.model.language_model = TinyLanguageModel(layer_count)
+        self.config = SimpleNamespace(
+            model_type="qwen3_vl",
+            text_config=SimpleNamespace(
+                num_hidden_layers=layer_count,
+            ),
+            vision_config=SimpleNamespace(
+                deepstack_visual_indexes=[8, 16, 24],
+            ),
+        )
+
+
+def test_architecture_contract_covers_seven_language_projections():
+    model = TinyQwen3VL(2)
+    report = audit_qwen3_vl(model, expected_layers=2)
+
+    assert get_layers(model) is model.model.language_model.layers
+    assert tuple(short for _, short, _, _ in PROJECTIONS) == (
+        "v",
+        "q",
+        "k",
+        "o",
+        "up",
+        "gate",
+        "down",
+    )
+    assert HESSIAN_NAMES == ("qkv", "o", "up", "down")
+    assert report["projection_count"] == 14
+    assert report["deepstack_language_injection_layers"] == [0, 1, 2]
+    assert projection_state_key(3, "self_attn.q_proj") == (
+        "model.language_model.layers.3.self_attn.q_proj.weight"
+    )
+
+
+def test_quant_order_matches_qtip_finetune_contract():
+    assert quant_order() == [
+        ("self_attn.v_proj", "v", "qkv", "v", "col"),
+        ("self_attn.q_proj", "q", "qkv", "q", "col"),
+        ("self_attn.k_proj", "k", "qkv", "k", "col"),
+        ("self_attn.o_proj", "o", "o", "o", "row"),
+        ("mlp.up_proj", "up", "up", "up", "col"),
+        ("mlp.gate_proj", "gate", "up", "gate", "col"),
+        ("mlp.down_proj", "down", "down", "down", "row"),
+    ]
+
+
+def test_flat_checkpoint_names_require_marker_and_all_projections():
+    from tempfile import TemporaryDirectory
+
+    with TemporaryDirectory() as directory:
+        checkpoint_dir = Path(directory)
+        expected = tuple(
+            checkpoint_dir / f"4_{short}.pt"
+            for _, short, _, _ in PROJECTIONS
+        )
+        assert projection_paths(4, checkpoint_dir) == expected
+        assert not layer_complete(4, checkpoint_dir)
+
+        for path in expected:
+            path.touch()
+        assert not layer_complete(4, checkpoint_dir)
+
+        (checkpoint_dir / "4.complete").write_text("complete\n")
+        assert layer_complete(4, checkpoint_dir)
+
+        expected[0].unlink()
+        assert not layer_complete(4, checkpoint_dir)
+
+
+def test_flat_hessian_names_are_layer_scoped():
+    from tempfile import TemporaryDirectory
+
+    with TemporaryDirectory() as directory:
+        hessian_dir = Path(directory)
+        assert not hessian_complete(5, hessian_dir)
+        for name in HESSIAN_NAMES:
+            (hessian_dir / f"5_{name}.pt").touch()
+        assert hessian_complete(5, hessian_dir)
+
+
+def test_audit_rejects_non_linear_target_projection():
+    model = TinyQwen3VL(1)
+    model.model.language_model.layers[0].mlp.down_proj = nn.Identity()
+    try:
+        audit_qwen3_vl(model, expected_layers=1)
+    except TypeError as error:
+        assert "mlp.down_proj" in str(error)
+    else:
+        raise AssertionError("Expected non-Linear target rejection")
+
+
+def test_real_transformers_qwen3vl_layer_matches_projection_contract():
+    from transformers import Qwen3VLTextConfig
+    from transformers.models.qwen3_vl.modeling_qwen3_vl import (
+        Qwen3VLTextDecoderLayer,
+    )
+
+    config = Qwen3VLTextConfig(
+        vocab_size=64,
+        hidden_size=32,
+        intermediate_size=64,
+        num_hidden_layers=1,
+        num_attention_heads=4,
+        num_key_value_heads=2,
+        head_dim=8,
+    )
+    layer = Qwen3VLTextDecoderLayer(config, layer_idx=0)
+
+    for attribute, _, _, _ in PROJECTIONS:
+        module = layer
+        for component in attribute.split("."):
+            module = getattr(module, component)
+        assert isinstance(module, torch.nn.Linear)
