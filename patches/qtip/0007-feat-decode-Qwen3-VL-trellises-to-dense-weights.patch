 EXPECTED_LAYERS = 36
@@ -50,6 +52,30 @@ def layer_complete(
     )
 
 
+def atomic_write_completion(
+    layer_index: int,
+    checkpoint_dir: str | Path,
+) -> None:
+    checkpoint_dir = Path(checkpoint_dir)
+    missing = [
+        path
+        for path in projection_paths(layer_index, checkpoint_dir)
+        if not path.is_file()
+    ]
+    if missing:
+        raise RuntimeError(
+            f"layer {layer_index} is missing QTIP checkpoints: {missing}"
+        )
+    marker = checkpoint_dir / f"{layer_index}.complete"
+    marker.parent.mkdir(parents=True, exist_ok=True)
+    temporary = marker.with_name(f".{marker.name}.tmp-{os.getpid()}")
+    try:
+        temporary.write_text("complete\n")
+        os.replace(temporary, marker)
+    finally:
+        temporary.unlink(missing_ok=True)
+
+
 def hessian_complete(
     layer_index: int,
     hessian_dir: str | Path,
@@ -177,6 +203,83 @@ def projection_state_key(layer_index: int, projection: str) -> str:
     )
 
 
+def reconstruct_dense_weight(
+    saved: dict,
+    config: dict,
+) -> torch.Tensor:
+    """Decode one native bitshift checkpoint into its dense QDQ weight."""
+    from lib.codebook.bitshift import bitshift_codebook
+    from lib.utils.matmul_had import matmul_hadU
+
+    if int(saved.get("rcp", 0)) != 0:
+        raise NotImplementedError(
+            "dense Qwen3-VL export does not use TP packing"
+        )
+    quant = config.get("quantization", config)
+    su = saved["SU"].float()
+    sv = saved["SV"].float() * saved["Wscale"].float()
+    out_features, in_features = len(sv), len(su)
+    cb = bitshift_codebook(
+        L=quant["L"],
+        K=quant["K"],
+        V=quant["V"],
+        tlut_bits=quant["tlut_bits"],
+        decode_mode=quant["decode_mode"],
+        tlut=saved.get("tlut"),
+    )
+    trellis = cb.unpack_trellis(
+        saved["trellis"], quant["td_x"] * quant["td_y"]
+    )
+    raw = cb.recons(trellis).transpose(0, 1).transpose(1, 2).reshape(
+        out_features // quant["td_x"],
+        in_features // quant["td_y"],
+        quant["td_x"],
+        quant["td_y"],
+    ).transpose(1, 2).reshape(out_features, in_features)
+    transformed = matmul_hadU(matmul_hadU(raw.float() / 32).T).T
+    return ((transformed * su) * (sv * 32).unsqueeze(1)).contiguous()
+
+
+def inject_dense_checkpoints(
+    model: nn.Module,
+    checkpoint_dir: str | Path,
+    config: dict,
+    *,
+    layer_start: int,
+    layer_end: int,
+    reconstruct=None,
+) -> list[str]:
+    checkpoint_dir = Path(checkpoint_dir)
+    layers = get_layers(model)
+    if reconstruct is None:
+        reconstruct = reconstruct_dense_weight
+    modified = []
+    with torch.no_grad():
+        for layer_index in range(layer_start, layer_end):
+            if not layer_complete(layer_index, checkpoint_dir):
+                raise RuntimeError(
+                    f"QTIP layer {layer_index} is not complete"
+                )
+            layer = layers[layer_index]
+            for attribute, short, _, _ in PROJECTIONS:
+                path = checkpoint_dir / f"{layer_index}_{short}.pt"
+                saved = torch.load(
+                    path, map_location="cpu", weights_only=True
+                )
+                dense = reconstruct(saved, config)
+                linear = attrgetter(attribute)(layer)
+                if tuple(dense.shape) != tuple(linear.weight.shape):
+                    raise RuntimeError(
+                        f"{path.name}: {tuple(dense.shape)} != "
+                        f"{tuple(linear.weight.shape)}"
+                    )
+                linear.weight.copy_(dense.to(linear.weight.dtype))
+                modified.append(
+                    projection_state_key(layer_index, attribute)
+                )
+    return modified
+
+
 def freeze_non_qtip_parameters(layer: nn.Module) -> None:
     for parameter in layer.parameters():
