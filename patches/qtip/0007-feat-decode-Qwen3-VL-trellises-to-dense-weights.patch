+def test_completion_marker_requires_all_projection_checkpoints():
+    from tempfile import TemporaryDirectory
+
+    with TemporaryDirectory() as directory:
+        checkpoint_dir = Path(directory)
+        with pytest.raises(RuntimeError, match="missing QTIP checkpoints"):
+            atomic_write_completion(0, checkpoint_dir)
+        assert not (checkpoint_dir / "0.complete").exists()
+
+
+def test_dense_injection_targets_all_seven_projections():
+    from tempfile import TemporaryDirectory
+
+    model = TinyQwen3VL(1)
+    with TemporaryDirectory() as directory:
+        checkpoint_dir = Path(directory)
+        for _, short, _, _ in PROJECTIONS:
+            torch.save(
+                {"dense": torch.full((16, 16), 0.25)},
+                checkpoint_dir / f"0_{short}.pt",
+            )
+        atomic_write_completion(0, checkpoint_dir)
+        modified = inject_dense_checkpoints(
+            model,
+            checkpoint_dir,
+            {},
+            layer_start=0,
+            layer_end=1,
+            reconstruct=lambda saved, _config: saved["dense"],
+        )
+
+    assert len(modified) == 7
+    for attribute, _, _, _ in PROJECTIONS:
+        module = model.model.language_model.layers[0]
+        for component in attribute.split("."):
+            module = getattr(module, component)
+        torch.testing.assert_close(
+            module.weight,
+            torch.full_like(module.weight, 0.25),
+        )
+
