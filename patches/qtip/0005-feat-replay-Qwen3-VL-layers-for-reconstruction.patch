+def test_reconstruction_adapter_replays_kwargs_and_masks_padding():
+    layer = ReplayLayer()
+    with torch.no_grad():
+        layer.projection.weight.copy_(torch.eye(2))
+    captured = captured_split()
+    target = captured.first_layer_inputs[0] * 2
+    target[:, 1, :] = -1000
+    batches = build_reconstruction_batches(
+        captured.first_layer_inputs,
+        [target],
+        captured,
+        0,
+    )
+    adapter = MultimodalReconstructionAdapter(
+        batches,
+        batches,
+        seed=0,
+        mask_padding=True,
+    )
+
+    assert adapter.loss(layer, batches[0], "cpu").item() == 0
+    assert adapter.validation_loss(layer, "cpu") == 0
+    assert layer.last_kwargs["position_embeddings"][0].shape == (1, 3, 2)
