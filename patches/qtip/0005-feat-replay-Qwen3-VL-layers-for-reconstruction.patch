+def test_deepstack_is_replayed_after_language_layers_zero_one_two():
+    captured = captured_split(layer_count=4)
+    hidden = torch.zeros(1, 3, 2)
+
+    for layer_index, expected in enumerate((3.0, 5.0, 7.0)):
+        output = apply_post_layer_context(
+            [hidden],
+            captured,
+            layer_index,
+        )[0]
+        assert output[0, 1, 0].item() == expected
+    torch.testing.assert_close(
+        apply_post_layer_context([hidden], captured, 3)[0],
+        hidden,
+    )
