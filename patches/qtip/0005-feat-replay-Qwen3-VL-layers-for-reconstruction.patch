diff --git a/lib/qwen3_vl/replay.py b/lib/qwen3_vl/replay.py
new file mode 100644
index 0000000..0670931
--- /dev/null
+++ b/lib/qwen3_vl/replay.py
@@ -0,0 +1,413 @@
+"""Multimodal capture, replay, and reconstruction batches for QTIP."""
+
+from __future__ import annotations
+
+from contextlib import nullcontext
+from copy import deepcopy
+from dataclasses import dataclass
+from pathlib import Path
+
+import torch
+from torch import nn
+
+from paroquant.optim.multimodal import (
+    CocoCalibrationBatches,
+    apply_deepstack_context,
+)
+from paroquant.optim.util import (
+    RETAINED_KWARG_KEYS,
+    capture_layer_inputs_and_args,
+    to_device,
+)
+
+from .hessian import LayerHessianCollectors
+
+
+@dataclass
+class CapturedSplit:
+    first_layer_inputs: list[torch.Tensor]
+    kwargs_by_layer: list[list[dict]]
+    other_args_by_layer: list[list[tuple[torch.Tensor, ...]]]
+    retained_kwargs: list[dict]
+    deepstack_contexts: list[dict]
+    valid_masks: list[torch.Tensor]
+    sample_ids: list[str]
+
+    @property
+    def sample_count(self) -> int:
+        return sum(mask.shape[0] for mask in self.valid_masks)
+
+
+class _RecordingCalibration:
+    def __init__(self, source: CocoCalibrationBatches) -> None:
+        self.source = source
+        self.valid_masks: list[torch.Tensor] = []
+
+    def __iter__(self):
+        if self.valid_masks:
+            raise RuntimeError("Calibration recorder may only be consumed once")
+        for batch in self.source:
+            if "attention_mask" not in batch:
+                raise KeyError("Processor batch has no attention_mask")
+            self.valid_masks.append(
+                batch["attention_mask"].detach().cpu().to(torch.bool)
+            )
+            yield batch
+
+
+def capture_split(
+    model: nn.Module,
+    layers: nn.ModuleList,
+    *,
+    manifest_path: str | Path,
+    model_path: str | Path,
+    split: str,
+    sample_count: int,
+    batch_size: int,
+    device: torch.device | str,
+) -> CapturedSplit:
+    if sample_count <= 0:
+        raise ValueError("sample_count must be positive")
+    source = CocoCalibrationBatches(
+        manifest_path,
+        model_path=model_path,
+        split=split,
+        batch_size=batch_size,
+        limit=sample_count,
+    )
+    if len(source.records) != sample_count:
+        raise RuntimeError(
+            f"Requested {sample_count} {split} samples, found "
+            f"{len(source.records)}"
+        )
+    sample_ids = [str(record["id"]) for record in source.records]
+    recorder = _RecordingCalibration(source)
+    (
+        first_layer_inputs,
+        kwargs_by_layer,
+        other_args_by_layer,
+        retained_kwargs,
+        deepstack_contexts,
+    ) = capture_layer_inputs_and_args(
+        model,
+        layers,
+        recorder,
+        batch_size=None,
+        device=device,
+    )
+    if len(first_layer_inputs) != len(recorder.valid_masks):
+        raise RuntimeError(
+            "Captured input and attention-mask batch counts differ: "
+            f"{len(first_layer_inputs)} vs {len(recorder.valid_masks)}"
+        )
+    for index, (hidden, mask) in enumerate(
+        zip(first_layer_inputs, recorder.valid_masks)
+    ):
+        if tuple(hidden.shape[:2]) != tuple(mask.shape):
+            raise RuntimeError(
+                f"Batch {index} hidden/mask mismatch: "
+                f"{tuple(hidden.shape)} vs {tuple(mask.shape)}"
+            )
+    return CapturedSplit(
+        first_layer_inputs=first_layer_inputs,
+        kwargs_by_layer=kwargs_by_layer,
+        other_args_by_layer=other_args_by_layer,
+        retained_kwargs=retained_kwargs,
+        deepstack_contexts=deepstack_contexts,
+        valid_masks=recorder.valid_masks,
+        sample_ids=sample_ids,
+    )
+
+
+def _hidden(output) -> torch.Tensor:
+    if isinstance(output, torch.Tensor):
+        return output
+    if isinstance(output, (tuple, list)):
+        return output[0]
+    if hasattr(output, "last_hidden_state"):
+        return output.last_hidden_state
+    raise TypeError(f"Unsupported decoder output: {type(output).__name__}")
+
+
+@torch.no_grad()
+def forward_original_layer(
+    layer: nn.Module,
+    input_batches: list[torch.Tensor],
+    captured: CapturedSplit,
+    layer_index: int,
+    *,
+    device: torch.device | str,
+    collectors: LayerHessianCollectors | None = None,
+    autocast_dtype: torch.dtype | None = None,
+    retained_kwargs: list[dict] | None = None,
+) -> tuple[list[torch.Tensor], list[dict]]:
+    batch_count = len(input_batches)
+    retained_source = (
+        captured.retained_kwargs
+        if retained_kwargs is None
+        else retained_kwargs
+    )
+    expected = (
+        len(captured.kwargs_by_layer[layer_index]),
+        len(captured.other_args_by_layer[layer_index]),
+        len(retained_source),
+        len(captured.valid_masks),
+    )
+    if any(count != batch_count for count in expected):
+        raise ValueError(
+            f"Layer {layer_index} replay batch mismatch: "
+            f"inputs={batch_count}, related={expected}"
+        )
+
+    updated_retained = deepcopy(retained_source)
+    outputs = []
+    device_type = torch.device(device).type
+    autocast = (
+        torch.amp.autocast(device_type, dtype=autocast_dtype)
+        if autocast_dtype is not None
+        else nullcontext()
+    )
+    with autocast:
+        for batch_index, hidden in enumerate(input_batches):
+            if collectors is not None:
+                collectors.set_position_mask(
+                    captured.valid_masks[batch_index]
+                )
+            kwargs = to_device(
+                deepcopy(
+                    captured.kwargs_by_layer[layer_index][batch_index]
+                ),
+                device,
+            )
+            for key in RETAINED_KWARG_KEYS:
+                if key in updated_retained[batch_index]:
+                    kwargs[key] = to_device(
+                        updated_retained[batch_index][key],
+                        device,
+                    )
+            other_args = to_device(
+                captured.other_args_by_layer[layer_index][batch_index],
+                device,
+            )
+            output = _hidden(
+                layer(
+                    hidden.to(device),
+                    *other_args,
+                    **kwargs,
+                )
+            )
+            outputs.append(output.cpu())
+            for key in RETAINED_KWARG_KEYS:
+                if key in kwargs:
+                    updated_retained[batch_index][key] = to_device(
+                        kwargs[key],
+                        "cpu",
+                    )
+    return outputs, updated_retained
+
+
+def apply_post_layer_context(
+    outputs: list[torch.Tensor],
+    captured: CapturedSplit,
+    layer_index: int,
+) -> list[torch.Tensor]:
+    if len(outputs) != len(captured.deepstack_contexts):
+        raise ValueError(
+            "Output and DeepStack context batch counts differ: "
+            f"{len(outputs)} vs {len(captured.deepstack_contexts)}"
+        )
+    return [
+        apply_deepstack_context(output, context, layer_index)
+        for output, context in zip(
+            outputs,
+            captured.deepstack_contexts,
+        )
+    ]
+
+
+@dataclass
+class ReconstructionBatch:
+    source: torch.Tensor
+    target: torch.Tensor
+    other_args: tuple[torch.Tensor, ...]
+    kwargs: dict
+    retained_kwargs: dict
+    valid_mask: torch.Tensor
+
+
+def build_reconstruction_batches(
+    input_batches: list[torch.Tensor],
+    target_batches: list[torch.Tensor],
+    captured: CapturedSplit,
+    layer_index: int,
+    *,
+    retained_kwargs: list[dict] | None = None,
+) -> list[ReconstructionBatch]:
+    batch_count = len(input_batches)
+    retained_source = (
+        captured.retained_kwargs
+        if retained_kwargs is None
+        else retained_kwargs
+    )
+    related = (
+        len(target_batches),
+        len(captured.kwargs_by_layer[layer_index]),
+        len(captured.other_args_by_layer[layer_index]),
+        len(retained_source),
+        len(captured.valid_masks),
+    )
+    if any(count != batch_count for count in related):
+        raise ValueError(
+            f"Layer {layer_index} reconstruction batch mismatch: "
+            f"inputs={batch_count}, related={related}"
+        )
+    return [
+        ReconstructionBatch(
+            source=source,
+            target=target,
+            other_args=other_args,
+            kwargs=kwargs,
+            retained_kwargs=retained,
+            valid_mask=mask,
+        )
+        for source, target, other_args, kwargs, retained, mask in zip(
+            input_batches,
+            target_batches,
+            captured.other_args_by_layer[layer_index],
+            captured.kwargs_by_layer[layer_index],
+            retained_source,
+            captured.valid_masks,
+        )
+    ]
+
+
+def masked_mse(
+    prediction: torch.Tensor,
+    target: torch.Tensor,
+    valid_mask: torch.Tensor,
+) -> torch.Tensor:
+    if prediction.shape != target.shape:
+        raise ValueError(
+            f"Prediction/target shape mismatch: "
+            f"{tuple(prediction.shape)} vs {tuple(target.shape)}"
+        )
+    if tuple(prediction.shape[:2]) != tuple(valid_mask.shape):
+        raise ValueError(
+            f"Hidden/mask shape mismatch: {tuple(prediction.shape)} vs "
+            f"{tuple(valid_mask.shape)}"
+        )
+    selected = (prediction.float() - target.float())[
+        valid_mask.to(device=prediction.device, dtype=torch.bool)
+    ]
+    if selected.numel() == 0:
+        raise ValueError("Cannot compute MSE without valid positions")
+    return selected.square().mean()
+
+
+class MultimodalReconstructionAdapter:
+    """Duck-typed adapter consumed by QTIP's layer fine-tuner."""
+
+    def __init__(
+        self,
+        train_batches: list[ReconstructionBatch],
+        validation_batches: list[ReconstructionBatch],
+        *,
+        seed: int,
+        mask_padding: bool,
+    ) -> None:
+        if not train_batches or not validation_batches:
+            raise ValueError(
+                "Reconstruction train and validation batches are required"
+            )
+        self.train = train_batches
+        self.validation = validation_batches
+        self.seed = seed
+        self.mask_padding = mask_padding
+
+    def iter_train(self, epoch: int):
+        generator = torch.Generator().manual_seed(self.seed + epoch)
+        for index in torch.randperm(
+            len(self.train),
+            generator=generator,
+        ).tolist():
+            yield self.train[index]
+
+    def _forward(
+        self,
+        layer: nn.Module,
+        batch: ReconstructionBatch,
+        device: torch.device | str,
+    ) -> torch.Tensor:
+        kwargs = to_device(deepcopy(batch.kwargs), device)
+        for key in RETAINED_KWARG_KEYS:
+            if key in batch.retained_kwargs:
+                kwargs[key] = to_device(
+                    deepcopy(batch.retained_kwargs[key]),
+                    device,
+                )
+        return _hidden(
+            layer(
+                batch.source.to(device),
+                *to_device(batch.other_args, device),
+                **kwargs,
+            )
+        )
+
+    def loss(
+        self,
+        layer: nn.Module,
+        batch: ReconstructionBatch,
+        device: torch.device | str,
+    ) -> torch.Tensor:
+        prediction = self._forward(layer, batch, device)
+        target = batch.target.to(device)
+        if self.mask_padding:
+            return masked_mse(
+                prediction,
+                target,
+                batch.valid_mask,
+            )
+        return torch.nn.functional.mse_loss(
+            prediction.float(),
+            target.float(),
+        )
+
+    @torch.no_grad()
+    def validation_loss(
+        self,
+        layer: nn.Module,
+        device: torch.device | str,
+    ) -> float:
+        was_training = layer.training
+        layer.eval()
+        total_squared_error = torch.zeros((), device=device)
+        total_elements = 0
+        try:
+            for batch in self.validation:
+                prediction = self._forward(layer, batch, device)
+                target = batch.target.to(device)
+                difference = prediction.float() - target.float()
+                if self.mask_padding:
+                    selected = difference[
+                        batch.valid_mask.to(
+                            device=device,
+                            dtype=torch.bool,
+                        )
+                    ]
+                else:
+                    selected = difference
+                total_squared_error += selected.square().sum()
+                total_elements += selected.numel()
+        finally:
+            layer.train(was_training)
+        if total_elements == 0:
+            raise ValueError("Validation set contains no scored elements")
+        return (total_squared_error / total_elements).cpu().item()
+
+    @torch.no_grad()
+    def materialize(
+        self,
+        layer: nn.Module,
+        device: torch.device | str,
+    ) -> None:
+        self._forward(layer, self.train[0], device)
