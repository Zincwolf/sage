+from dataclasses import replace
+
+import torch
+from torch import nn
+
+from lib.qwen3_vl.common import freeze_non_qtip_parameters
+from lib.qwen3_vl.replay import (
+    CapturedSplit,
+    MultimodalReconstructionAdapter,
+    ReconstructionBatch,
+    apply_post_layer_context,
+    build_reconstruction_batches,
+    forward_original_layer,
+    masked_mse,
+)
+
+
+class ReplayLayer(nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.projection = nn.Linear(2, 2, bias=False)
+        self.last_kwargs = None
+
+    def forward(
+        self,
+        hidden_states,
+        position_embeddings,
+        attention_mask=None,
+        position_ids=None,
+        scale=1.0,
+        **kwargs,
+    ):
+        self.last_kwargs = {
+            "position_embeddings": position_embeddings,
+            "attention_mask": attention_mask,
+            "position_ids": position_ids,
+            **kwargs,
+        }
+        return self.projection(hidden_states) * scale
+
+
+def captured_split(layer_count=1):
+    mask = torch.tensor([[True, False, True]])
+    position_embeddings = (
+        torch.ones(1, 3, 2),
+        torch.zeros(1, 3, 2),
+    )
+    return CapturedSplit(
+        first_layer_inputs=[torch.ones(1, 3, 2)],
+        kwargs_by_layer=[
+            [
+                {
+                    "position_embeddings": position_embeddings,
+                    "attention_mask": torch.ones(1, 1, 3, 3),
+                    "position_ids": torch.arange(3).unsqueeze(0),
+                    "scale": 2.0,
+                }
+            ]
+            for _ in range(layer_count)
+        ],
+        other_args_by_layer=[[()] for _ in range(layer_count)],
+        retained_kwargs=[{}],
+        deepstack_contexts=[
+            {
+                "valid_token_mask": mask,
+                "visual_pos_masks": torch.tensor(
+                    [[False, True, False]]
+                ),
+                "deepstack_visual_embeds": [
+                    torch.tensor([[3.0, 4.0]]),
+                    torch.tensor([[5.0, 6.0]]),
+                    torch.tensor([[7.0, 8.0]]),
+                ],
+            }
+        ],
+        valid_masks=[mask],
+        sample_ids=["sample"],
+    )
+
+
+def test_forward_replays_real_layer_kwargs_and_collects_valid_hessian():
+    class MaskRecorder:
+        def __init__(self):
+            self.masks = []
+
+        def set_position_mask(self, mask):
+            self.masks.append(mask)
+
+    layer = ReplayLayer()
+    captured = captured_split()
+    collectors = MaskRecorder()
+
+    outputs, retained = forward_original_layer(
+        layer,
+        captured.first_layer_inputs,
+        captured,
+        0,
+        device="cpu",
+        collectors=collectors,
+    )
+
+    assert len(outputs) == 1
+    assert retained == [{}]
+    assert collectors.masks[0].tolist() == [[True, False, True]]
+    assert layer.last_kwargs["position_embeddings"][0].shape == (1, 3, 2)
+    assert layer.last_kwargs["position_ids"].shape == (1, 3)
+    assert layer.last_kwargs["attention_mask"].shape == (1, 1, 3, 3)
+
