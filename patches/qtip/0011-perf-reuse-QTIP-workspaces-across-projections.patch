From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Zincwolf <zincwolf@outlook.com>
Date: Sat, 12 Sep 2026 17:40:49 +0800
Subject: [PATCH] perf: reuse QTIP workspaces across projections

---
 lib/algo/finetune.py           | 25 +++++++++----------------
 lib/algo/ldlq.py               | 10 +++-------
 lib/linear/quantized_linear.py |  4 +---
 lib/utils/math_utils.py        |  4 ++--
 lib/utils/matmul_had.py        |  3 ---
 5 files changed, 15 insertions(+), 31 deletions(-)

diff --git a/lib/algo/finetune.py b/lib/algo/finetune.py
index fec8efc..0b172a1 100644
--- a/lib/algo/finetune.py
+++ b/lib/algo/finetune.py
@@ -146,6 +146,8 @@ def quantize_finetune_decoder_layer(mixed_layer, quant_order, idx, cb, args,
         orig_dtype = p.dtype
         break
     mixed_layer = mixed_layer.float()
+    # Reuse the codebook and CUDA allocator throughout this work layer.
+    cb = cb.to(device).to(orig_dtype)
 
     if args.reconstruction_epochs > 0:
         if reconstruction_adapter is None and reconstruction_callback is None:
@@ -248,15 +250,10 @@ def quantize_finetune_decoder_layer(mixed_layer, quant_order, idx, cb, args,
                 attrgetter('.'.join(split_attr[:-1]))(mixed_layer),
                 split_attr[-1],
                 build_quantized_linear(projection_payloads[name], m, n))
-    if completed and args.reconstruction_epochs > 0:
-        mixed_layer = mixed_layer.cpu()
-
     for quant_i, (linear_attr, name, in_hess_name, out_hess_name,
                   rcp) in enumerate(quant_order):
         if quant_i < completed:
             continue
-        utils.clean()
-        cb = cb.to(device).to(orig_dtype)
         orig_linear = attrgetter(linear_attr)(mixed_layer)
         W = orig_linear.weight.to(dtype_)
         del orig_linear
@@ -337,14 +334,14 @@ def quantize_finetune_decoder_layer(mixed_layer, quant_order, idx, cb, args,
         if block_ldl is None:
             # Finite-precision Hadamard transforms can lose positive definiteness.
             # Restore symmetry and retry once with damping in these coordinates.
-            utils.clean()
             HRr = (HRr + HRr.T) * 0.5
             HRr.diagonal().add_(HRr.diagonal().mean() * args.sigma_reg)
             block_ldl = utils.block_LDL(HRr.contiguous(), args.td_y)
         if block_ldl is None:
             raise RuntimeError(
                 f'block LDL failed for layer {idx} projection {name}')
-        LRr, _ = block_ldl
+        LRr = block_ldl[0]
+        del block_ldl
         diag = torch.arange(n, device=LRr.device)
         LRr[diag, diag] = 0
 
@@ -412,21 +409,19 @@ def quantize_finetune_decoder_layer(mixed_layer, quant_order, idx, cb, args,
         }
         projection_payloads[name] = payload
 
-        del HRr, Wr, hatWr, LRr, Qidxs
-        utils.clean()
+        # Drop live workspaces, but keep allocator blocks reusable by the next
+        # projection. Forced GC/cache eviction belongs at the layer boundary.
+        del W, HR, HRr, Wr, hatWr, LRr, Qidxs, diag
 
         if args.reconstruction_epochs == 0:
             if progress_callback is not None:
                 progress_callback(quant_i + 1, projection_payloads)
             del packed, SU, SV, Wscale
-            cb = cb.cpu()
-            utils.clean()
             continue
         
         q_linear = build_quantized_linear(payload, m, n)
 
-        del packed, SU, SV
-        utils.clean()
+        del packed, SU, SV, Wscale
 
         split_attr = linear_attr.split('.')
         setattr(
@@ -437,7 +432,6 @@ def quantize_finetune_decoder_layer(mixed_layer, quant_order, idx, cb, args,
         if (reconstruction_groups is not None
                 and quant_i + 1 < len(quant_order)
                 and reconstruction_groups[quant_i] == reconstruction_groups[quant_i + 1]):
-            cb = cb.cpu()
             continue
 
         with torch.enable_grad():
@@ -458,9 +452,8 @@ def quantize_finetune_decoder_layer(mixed_layer, quant_order, idx, cb, args,
         refresh_payloads(quant_i + 1)
         if progress_callback is not None:
             progress_callback(quant_i + 1, projection_payloads)
-        cb = cb.cpu()
-        utils.clean()
 
+    cb = cb.cpu()
     if args.reconstruction_epochs == 0:
         if write_checkpoints:
             for _linear_attr, name, _ih, _oh, _rcp in quant_order:
diff --git a/lib/algo/ldlq.py b/lib/algo/ldlq.py
index dac0e3b..fd73ee8 100644
--- a/lib/algo/ldlq.py
+++ b/lib/algo/ldlq.py
@@ -5,8 +5,6 @@ import glog
 import torch
 from tqdm import tqdm
 
-from lib import utils
-
 _PERMUTE = torch.arange(256).reshape(2, 8, 2, 4, 2).permute(1, 3, 2, 0,
                                                             4).flatten()
 _INV_PERMUTE = torch.zeros(256, dtype=torch.int64)
@@ -27,10 +25,9 @@ def LDLQ(Wr, L, cb, args, buf_cols=128, for_kernel=True):
     hatWr_T = torch.zeros(n, m, dtype=L.dtype, device=L.device)
     Qidxs_T = torch.zeros(n // args.V, m, dtype=cb.idx_dtype, device=L.device)
 
-    device = Wr.device
-    Wr = Wr.cpu()
-    utils.clean()
-    Wr_T = Wr.T.contiguous().to(device)
+    # The input already resides on the quantization device. Transpose there
+    # instead of staging the full weight through CPU memory.
+    Wr_T = Wr.T.contiguous()
 
     # quip
     prod_cache = torch.zeros(n, m, dtype=Wr_T.dtype, device=Wr_T.device)
@@ -76,5 +73,4 @@ def LDLQ(Wr, L, cb, args, buf_cols=128, for_kernel=True):
                 cur_col] = b_hatWr_T
 
     del b_Wr_T, b_hatWr_T, b_L, b_prod, L_offset, prod_cache
-    utils.clean()
     return hatWr_T.T.contiguous(), Qidxs_T.T.contiguous()
